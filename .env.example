# ===========================================
# NEURICO CONFIGURATION
# ===========================================
# Copy this file to .env and uncomment only the integrations you use.
#
# CLI tools (Claude Code, Codex, Gemini) use OAuth login, not API keys.
# Run your CLI tool once to authenticate: claude, codex, or gemini

# ─── OPTIONAL: LLM-assisted conversion, naming, paper-finder, and experiments ───
# OpenRouter is preferred; a direct OpenAI key also works. Without either key,
# IdeaHub and local text conversion use a template and repository naming uses a
# basic fallback. A scoring-enabled idea with a declared evaluation contract
# also uses this key for its tool-less scorer-verification API call. In HITL,
# a missing/unavailable API is reported to the manager and does not block review;
# the ordinary non-HITL scoring pipeline treats verification as a gate.
# OPENROUTER_KEY=
# OPENAI_API_KEY=
# NEURICO_EVAL_VERIFIER_MODEL=       # Optional verifier model override

# ─── OPTIONAL: Additional API keys (passed through to agent environment) ───
# Agents may use these during experiments (e.g., for model access, routing)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# HF_TOKEN=                          # Hugging Face (private models/datasets)
# WANDB_API_KEY=                     # Weights & Biases (experiment tracking)

# ─── OPTIONAL: Azure (two independent layers) ───
# 1) Research keys: NEURICO_AZURE=1 gives every agent the azure-models skill plus the
#    variables below, so GPT-family calls inside experiments go to the lab's Azure
#    OpenAI deployments (model = deployment name, e.g. gpt-6-astra, gpt-5.6-sol).
# 2) Agent backbone: NEURICO_AGENT_AUTH=azure runs the coding agent itself on Azure
#    (Codex via the Azure OpenAI v1 endpoint; Claude Code via Azure AI Foundry when a
#    Claude deployment exists). Default oauth = the provider CLI's own login.
#    Also available per run: ./neurico run <id> --provider codex --agent-auth azure --model gpt-6-astra
# NEURICO_AZURE=1
# AZURE_OPENAI_API_KEY=
# AZURE_FOUNDRY_RESOURCE=            # -> https://<resource>.openai.azure.com/openai/v1
# AZURE_OPENAI_BASE_URL=             # optional explicit base URL (wins over the resource)
# AZURE_OPENAI_DEPLOYMENTS=gpt-6-astra,gpt-5.6-sol,gpt-5.4,gpt-4.1-mini   # optional allow-list
# NEURICO_AGENT_AUTH=oauth           # oauth | azure
# NEURICO_AZURE_CODEX_MODEL=gpt-5.6-sol   # Codex deployment when --model is not given
# ANTHROPIC_FOUNDRY_API_KEY=         # optional (falls back to AZURE_OPENAI_API_KEY)
# ANTHROPIC_FOUNDRY_RESOURCE=        # -> https://<resource>.services.ai.azure.com/anthropic

# ─── OPTIONAL: mathematics_lean domain (Axiom AXLE Lean verification) ───
# Hosted Lean 4 + Mathlib proof verification API (https://axle.axiommath.ai).
# Required ONLY for the mathematics_lean research domain; the axiom-lean-prover
# skill uses it instead of a local lake/Mathlib toolchain. Get a key at axle.axiommath.ai.
# AXLE_API_KEY=pk_...
# AXLE_ENV=lean-4.29.0               # Optional: pin the Lean version used for checking

# ─── OPTIONAL: GitHub integration ───
# We recommend a Classic token for simplicity.
# Create one at: https://github.com/settings/tokens/new
# Select the "repo" scope (covers public and private repos, personal and org)
# GITHUB_TOKEN=ghp_...
# GITHUB_ORG=YourOrgName             # Optional: leave empty to use your personal account

# ─── OPTIONAL: Paper-finder service ───
# Enables high-quality literature search with relevance ranking.
# Without these, agents use manual search (arXiv, Semantic Scholar, Papers with Code)
#
# Paper-finder requires S2_API_KEY and either OPENROUTER_KEY or OPENAI_API_KEY.
# Get S2_API_KEY at: https://www.semanticscholar.org/product/api
# S2_API_KEY=...
#
# Get COHERE_API_KEY at: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=...                 # Optional: improves ranking by ~7%

# No GitHub token or API key is required for a basic local research run.
