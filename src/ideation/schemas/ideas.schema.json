{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "problem_title": {
      "type": "string",
      "minLength": 1
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^idea_[1-9][0-9]*$"
          },
          "title": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          },
          "axis": {
            "enum": [
              "evals",
              "interpretability",
              "control_oversight",
              "security_injection",
              "training_time_fixes"
            ]
          },
          "hypothesis": {
            "type": "string",
            "minLength": 20,
            "maxLength": 420,
            "description": "<= 50 words (code checks words; maxLength is the character backstop)."
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2100,
            "description": "<= 250 words (code checks words; maxLength is the character backstop)."
          },
          "method_steps": {
            "type": "array",
            "minItems": 3,
            "maxItems": 7,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 210
            },
            "description": "3-7 one-line steps (<= 25 words each) a reader can skim; the method paragraph carries the detail."
          },
          "resources": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 504,
            "description": "<= 60 words (code checks words; maxLength is the character backstop)."
          },
          "builds_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks": {
            "type": "string",
            "minLength": 1
          },
          "closest_prior_work": {
            "type": "string"
          },
          "neurico": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1,
                "description": "NeuriCo domain key; `ai_safety` for everything this engine runs (config/domains.yaml)."
              },
              "background": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "papers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "url",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "datasets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "source"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "code_references": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "repo": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "repo",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "description",
                  "papers"
                ],
                "additionalProperties": false
              },
              "methodology": {
                "type": "object",
                "properties": {
                  "approach": {
                    "type": "string",
                    "minLength": 1
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "baselines": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "metrics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "approach",
                  "steps",
                  "baselines",
                  "metrics"
                ],
                "additionalProperties": false
              },
              "constraints": {
                "type": "object",
                "properties": {
                  "compute": {
                    "enum": [
                      "cpu_only",
                      "gpu_required",
                      "multi_gpu",
                      "tpu",
                      "any"
                    ]
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "time_limit": {
                    "type": "integer"
                  },
                  "memory": {
                    "type": "string"
                  },
                  "budget": {
                    "type": "number"
                  }
                },
                "required": [
                  "compute"
                ],
                "additionalProperties": false
              },
              "expected_outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "format": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "evaluation_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "job_kind": {
                "enum": [
                  "explore",
                  "optimise",
                  "validate"
                ],
                "description": "Which NeuriCo job runs the idea: explore (open-ended Standard run, the default), optimise (AutoResearch loop against the sealed metric in `evaluation`), validate (independent reproduction of the finding in `finding_id`)."
              },
              "finding_id": {
                "type": "string",
                "minLength": 1,
                "description": "Required when job_kind is validate: the finding id (without the `finding:` prefix) the run reproduces."
              },
              "evaluation": {
                "type": "object",
                "description": "Required when job_kind is optimise: the sealed metric NeuriCo's scorer computes.",
                "properties": {
                  "metric": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "enum": [
                      "maximize",
                      "minimize"
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "metric"
                ],
                "additionalProperties": true
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "catalog/models.yaml ids the run serves as subjects (and judges); sizes the GPU reservation."
              },
              "evals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "catalog/evals.yaml ids the run uses, when it uses catalog evaluations."
              }
            },
            "required": [
              "domain",
              "background",
              "methodology",
              "constraints",
              "expected_outputs",
              "evaluation_criteria"
            ],
            "additionalProperties": false
          },
          "category": {
            "type": "string",
            "description": "Optional: the catalog/evals.yaml category the idea's main measurement belongs to (e.g. refusal-calibration, sycophancy, deception-scheming)."
          }
        },
        "required": [
          "id",
          "title",
          "axis",
          "hypothesis",
          "method",
          "method_steps",
          "resources",
          "expected_result",
          "builds_on",
          "risks",
          "neurico"
        ],
        "additionalProperties": false
      },
      "minItems": 8
    }
  },
  "required": [
    "problem_title",
    "ideas"
  ],
  "additionalProperties": false
}
