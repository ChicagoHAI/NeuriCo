{
  "name": "neurico",
  "version": "0.4.0",
  "tagline": "NeuriCo: Standard, AutoResearch, and HITL research through Docker or local uv.",
  "description": "NeuriCo (Neural Co-Scientist) is an autonomous and human-in-the-loop research framework. Users submit a structured research idea and choose Standard, AutoResearch, or HITL AutoResearch. Docker and local uv are equal execution routes. NeuriCo supports Claude Code, Codex, and Gemini and can produce runnable code, scored experimental results, plots, reports, optional LaTeX papers, and optional GitHub repositories.",
  "category": "Research & Science",
  "tags": [
    "autonomous-research",
    "ai-scientist",
    "experiment-automation",
    "research-agent",
    "paper-writing",
    "literature-review",
    "hypothesis-testing",
    "scientific-computing",
    "human-in-the-loop",
    "autoresearch",
    "claude-code",
    "codex",
    "gemini",
    "latex",
    "docker",
    "multi-agent",
    "machine-learning",
    "data-science",
    "reproducible-research"
  ],
  "license": "Apache-2.0",
  "repository": "https://github.com/ChicagoHAI/neurico",
  "homepage": "https://github.com/ChicagoHAI/neurico",
  "support_url": "https://github.com/ChicagoHAI/neurico/issues",
  "authors": [
    "Haokun Liu",
    "Chenhao Tan"
  ],
  "requirements": {
    "minimal": ["git", "docker"],
    "alternative_minimal": ["git", "python>=3.10", "uv"],
    "recommended": ["provider-cli-oauth-login"],
    "optional": [
      "openai-api-key",
      "s2-api-key",
      "openrouter-key",
      "cohere-api-key",
      "hf-token",
      "wandb-api-key"
    ]
  },
  "supported_providers": ["claude-code", "codex", "gemini"],
  "input_format": "yaml",
  "output_artifacts": ["code", "results", "plots", "latex-paper", "github-repo", "report"]
}
