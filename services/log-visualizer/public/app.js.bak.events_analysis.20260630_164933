// Keyword search across EVERY decision — independent of importance/finding filters, so a
// reviewer can find anything the curated default views hide (a specific model, threshold,
// metric, prompt, etc.). The input keeps focus across keystrokes by only re-rendering the
// results container, not the whole page.
function renderSearch() {
  const points = decisionPoints();
  const findingText = (fid) => {
    const f = (run.researchState?.findings || []).find((x) => x.id === fid);
    return f ? `${f.id} ${f.text || ""} ${f.insight || ""}` : "";
  };
  const haystack = (p) => [
    p.id, p.question, p.chosen, p.situation, p.rationale, p.crux, p.finding, p.layer,
    findingText(p.finding),
    ...(p.options || []).map((o) => (typeof o === "string" ? o : o.text || "")),
  ].join("  ").toLowerCase();

  root.innerHTML = `
    <div class="decisions-page search-page">
      <section class="review-hero compact">
        <div>
          <span class="eyebrow">Search</span>
          <h3>Find any decision by keyword</h3>
          <p>Searches <strong>every</strong> decision — including routine ones hidden on the other pages. Matches the question, the chosen option, the alternatives, the rationale, and the finding it belongs to.</p>
        </div>
      </section>
      <input id="dp-search" class="search-input" type="text" autocomplete="off"
        placeholder="Search decisions…  e.g.  GPT-4o-mini · seed · threshold · prompt · baseline"
        value="${escapeHtml(searchQuery)}">
      <p class="dp-showing muted" id="search-count"></p>
      <div class="decision-list wide" id="search-results"></div>
    </div>`;

  const input = root.querySelector("#dp-search");
  const countEl = root.querySelector("#search-count");
  const resultsEl = root.querySelector("#search-results");

  const runSearch = () => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) {
      countEl.textContent = "";
      resultsEl.innerHTML = `<p class="muted">Type a keyword to search all ${points.length} decisions.</p>`;
      return;
    }
    const hits = points.filter((p) => haystack(p).includes(q));
    countEl.innerHTML = `<strong>${hits.length}</strong> of ${points.length} decision${hits.length === 1 ? "" : "s"} match “${escapeHtml(searchQuery.trim())}”`;
    resultsEl.innerHTML = hits.length
      ? hits.map((p) => renderDecisionCard(p)).join("")
      : `<p class="muted">No decisions match “${escapeHtml(searchQuery.trim())}”.</p>`;
    wireDecisionLinks();
    wirePaperPanes();
  };

  input.addEventListener("input", () => { searchQuery = input.value; runSearch(); });
  runSearch();
  input.focus();
  input.setSelectionRange(input.value.length, input.value.length);
}

