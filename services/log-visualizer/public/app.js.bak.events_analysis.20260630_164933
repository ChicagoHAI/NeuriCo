// Global "reviewer's take" toggle. OFF by default: the human reviewer sees the
// objective record (what was chosen, alternatives, evidence) without the AI's
// judgments anchoring them. Persisted; CSS (.hide-reviewer) hides .reviewer-only.
const REVIEWER_KEY = "neurico-show-reviewer";
function reviewerVisible() {
  return localStorage.getItem(REVIEWER_KEY) === "1";
}
function applyReviewerVisibility() {
  const on = reviewerVisible();
  document.body.classList.toggle("hide-reviewer", !on);
  const btn = document.querySelector("#reviewer-toggle");
  if (btn) {
    btn.setAttribute("aria-pressed", String(on));
    btn.classList.toggle("on", on);
    const state = btn.querySelector(".reviewer-toggle-state");
    if (state) state.textContent = on ? "On" : "Off";
  }
}
document.querySelector("#reviewer-toggle")?.addEventListener("click", () => {
  localStorage.setItem(REVIEWER_KEY, reviewerVisible() ? "0" : "1");
  applyReviewerVisibility();
});
