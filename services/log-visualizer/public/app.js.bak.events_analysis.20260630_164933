// Shows a live banner while the server auto-generates this project's world model,
// and reloads the page once it's ready.
function renderWorldModelBanner(info, kind) {
  let banner = document.querySelector("#wm-banner");
  if (kind === "hidden") {
    banner?.remove();
    return;
  }
  if (!banner) {
    banner = document.createElement("div");
    banner.id = "wm-banner";
    document.body.appendChild(banner);
  }
  banner.className = `wm-banner ${kind}`;
  const last = info.log?.length ? info.log[info.log.length - 1] : "";
  const secs = Math.round((info.elapsedMs || 0) / 1000);
  if (kind === "running") {
    banner.innerHTML = `
      <span class="wm-spin"></span>
      <div>
        <strong>Generating world model… ${secs ? `(${secs}s)` : ""}</strong>
        <span class="wm-sub">Reading the run's artifacts. Decisions &amp; Whiteboard will fill in. ${escapeHtml(last)}</span>
      </div>`;
  } else if (kind === "done") {
    banner.innerHTML = `<span class="wm-check">✓</span><div><strong>World model ready</strong><span class="wm-sub">Reloading…</span></div>`;
  } else {
    banner.innerHTML = `
      <span class="wm-x">⚠</span>
      <div><strong>World model not generated</strong><span class="wm-sub">${escapeHtml(info.message || "")}</span></div>
      <button class="wm-close" aria-label="Dismiss">✕</button>`;
    banner.querySelector(".wm-close").onclick = () => banner.remove();
  }
}

async function watchWorldModel() {
  let info;
  try {
    info = await (await fetch("/api/world-model-status")).json();
  } catch {
    return;
  }
  if (info.state === "running" || info.state === "checking") {
    sessionStorage.removeItem("wm-reloaded");      // a fresh build is in progress
    renderWorldModelBanner(info, "running");
    setTimeout(watchWorldModel, 3000);
  } else if (info.state === "done") {
    if (sessionStorage.getItem("wm-reloaded")) {   // already reloaded for this build
      renderWorldModelBanner(info, "hidden");
      return;
    }
    sessionStorage.setItem("wm-reloaded", "1");
    renderWorldModelBanner(info, "done");
    setTimeout(() => location.reload(), 1200);
  } else if (["failed", "error", "unavailable"].includes(info.state)) {
    renderWorldModelBanner(info, "error");
  } else {
    renderWorldModelBanner(info, "hidden"); // present / disabled
  }
}

// ---- Platform shell: entry (email) → run list → viewer ----
function renderApp() {
  updateChrome();
  if (currentScreen === "entry") return renderEmailEntry();
  if (currentScreen === "list") return renderRunList();
  render(); // viewer — the existing four-tab UI
}

// Topbar / nav reflect the current screen; the tabs only matter inside a run.
function updateChrome() {
  const viewer = currentScreen === "viewer";
  document.body.classList.toggle("no-run", !viewer);
  const back = document.querySelector("#back-to-list");
  const chip = document.querySelector("#user-chip");
  const eyebrow = document.querySelector("#run-eyebrow");
  if (back) back.hidden = !viewer;
  if (chip) { chip.hidden = !userEmail; chip.textContent = userEmail || ""; }
  if (eyebrow) eyebrow.textContent = viewer ? "Annotating" : "NeuriCo study";
  if (!viewer) {
    title.textContent = currentScreen === "entry" ? "Sign in" : "Choose a log";
    status.textContent = "";
    status.className = "status-pill";
  }
  navButtons.forEach((b) => b.classList.toggle("active", b.dataset.view === currentView));
}

function renderEmailEntry() {
  root.innerHTML = `
    <section class="panel entry-screen">
      <div class="entry-hero">
        <img class="entry-face" src="/head.jpg" alt="Your host">
        <div class="speech-bubble">
          <span class="eyebrow">NeuriCo annotation study</span>
          <strong class="speech-welcome">Welcome!</strong>
          <p class="muted">Enter your email to begin — it just labels your annotations, no password needed.</p>
        </div>
      </div>
      <form id="email-form" class="entry-form">
        <input type="email" id="email-input" placeholder="you@uchicago.edu" required autocomplete="email" autofocus>
        <button type="submit">Continue →</button>
      </form>
    </section>`;
  root.querySelector("#email-form").addEventListener("submit", (event) => {
    event.preventDefault();
    const value = root.querySelector("#email-input").value.trim().toLowerCase();
    if (!value) return;
    userEmail = value;
    localStorage.setItem(EMAIL_KEY, value);
    currentScreen = "list";
    renderApp();
  });
}

async function renderRunList() {
  root.innerHTML = `<section class="panel"><p class="muted">Loading logs…</p></section>`;
  let runs = [];
  try {
    runs = await (await fetch("/api/runs")).json();
  } catch {
    root.innerHTML = `<section class="panel"><h3>Couldn't load logs</h3><p class="muted">Is the server running?</p></section>`;
    return;
  }
  // Fewer reviewers first, so coverage spreads out on its own.
  runs.sort((a, b) => (a.annotatorCount || 0) - (b.annotatorCount || 0));
  root.innerHTML = `
    <section class="run-list-screen">
      <div class="run-list-head">
        <span class="eyebrow">Logs to annotate</span>
        <h3>Pick a log to review</h3>
        <p class="muted">Tip: logs with fewer annotations are listed first — choosing those helps spread coverage.</p>
      </div>
      <div class="run-cards">
        ${runs.map((r) => `
          <button class="run-card" data-open-run="${escapeHtml(r.runId)}">
            <div class="run-card-head">
              <span class="run-card-id">${escapeHtml(r.runId)}</span>
              <span class="run-card-count ${r.annotatorCount ? "" : "fresh"}">${r.annotatorCount ? `${r.annotatorCount} reviewer${r.annotatorCount === 1 ? "" : "s"}` : "not reviewed"}</span>
            </div>
            <p class="run-card-title">${escapeHtml(r.title || r.runId)}</p>
            <p class="run-card-meta">${r.decisionCount || 0} decisions</p>
          </button>`).join("") || `<p class="muted">No logs available yet.</p>`}
      </div>
    </section>`;
  root.querySelectorAll("[data-open-run]").forEach((el) =>
    el.addEventListener("click", () => openRun(el.dataset.openRun)));
}

async function openRun(runId) {
  currentRunId = runId;
  currentScreen = "viewer";
  currentView = "overview";
  pdfDocPromise = null;   // drop any PDF cached from a previously-open run
  run = null;
  root.innerHTML = `<section class="panel"><p class="muted">Loading…</p></section>`;
  updateChrome();
  try {
    run = await (await fetch(`/api/run?runId=${encodeURIComponent(runId)}&user=${encodeURIComponent(userEmail || "")}`)).json();
  } catch (error) {
    root.innerHTML = `<section class="panel"><h3>Failed to load log</h3><pre>${escapeHtml(error.message)}</pre></section>`;
    return;
  }
  title.textContent = run.idea?.title || run.runId || "Run";
  const unresolved = allErrors().filter((error) => error.status === "unresolved");
  status.textContent = unresolved.length ? "Needs Review" : (run.pipeline?.completed ? "Completed" : "Incomplete");
  status.className = unresolved.length ? "status-pill danger" : "status-pill";
  render();
}

function backToList() {
  currentRunId = null;
  run = null;
  pdfDocPromise = null;
  currentScreen = "list";
  renderApp();
}

document.querySelector("#back-to-list")?.addEventListener("click", backToList);
document.querySelector("#user-chip")?.addEventListener("click", () => {
  if (!window.confirm(`Sign out ${userEmail}?`)) return;
  userEmail = null;
  localStorage.removeItem(EMAIL_KEY);
  currentRunId = null;
  run = null;
  currentScreen = "entry";
  renderApp();
});

async function init() {
  wireAnnotationDelegation();
  wireEvidenceDelegation();
  userEmail = localStorage.getItem(EMAIL_KEY) || null;
  currentScreen = userEmail ? "list" : "entry";
  renderApp();
  watchWorldModel();   // poll build status: shows the bottom progress bar and auto-reloads when a build finishes
}

init().catch((error) => {
  root.innerHTML = `<section class="panel"><h3>Failed to load</h3><pre>${escapeHtml(error.stack || error.message)}</pre></section>`;
});
