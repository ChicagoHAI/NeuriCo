async function loadCanonicalTrajectory() {
  if (canonicalTrajectory && canonicalTrajectoryRunId === currentRunId) {
    return canonicalTrajectory;
  }

  const response = await fetch(`/api/canonical-run?runId=${encodeURIComponent(currentRunId)}`);
  if (!response.ok) {
    throw new Error(await response.text());
  }

  canonicalTrajectory = await response.json();
  canonicalTrajectoryRunId = currentRunId;
  return canonicalTrajectory;
}

async function saveEventAnnotation(eventId, eventIndex, action) {
  const response = await fetch("/api/annotations", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      runId: currentRunId,
      annotator: userEmail || "anonymous",
      annotationType: "canonical_event",
      eventId,
      eventIndex,
      labels: {
        should_update_user: action === "update" || action === "interrupt",
        interrupt_next_action: action === "interrupt",
        confidence: 3,
        annotator_rationale: `Demo label: ${action}`,
      },
    }),
  });

  const data = await response.json();
  if (!data.ok) {
    alert("Save failed");
    return;
  }

  alert("Annotation saved");
}

