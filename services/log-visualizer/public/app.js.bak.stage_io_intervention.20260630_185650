function holisticPickEvents(part) {
  const events = part.events || [];
  if (!events.length) return [];

  const picked = [];

  const add = (event, role) => {
    if (!event) return;
    if (picked.find((x) => x.event._id === event._id)) return;
    picked.push({ event, role });
  };

  add(events[0], "start");
  add(events[Math.floor(events.length / 2)], "middle");
  add(events[events.length - 1], "end");

  const important = [...events]
    .sort((a, b) => trImportanceScore(b) - trImportanceScore(a) || a._index - b._index)
    .slice(0, 4);

  for (const event of important) add(event, "important");

  return picked.slice(0, 8);
}

function holisticPartNarrative(part) {
  const picked = holisticPickEvents(part);
  const start = picked.find((x) => x.role === "start")?.event;
  const middle = picked.find((x) => x.role === "middle")?.event;
  const end = picked.find((x) => x.role === "end")?.event;

  const pieces = [];

  if (start) {
    const txt = cleanHumanText(start._text, 120);
    if (txt) pieces.push(`Started with: ${txt}`);
  }

  if (middle && middle._id !== start?._id) {
    const txt = cleanHumanText(middle._text, 120);
    if (txt) pieces.push(`Then: ${txt}`);
  }

  if (end && end._id !== start?._id && end._id !== middle?._id) {
    const txt = cleanHumanText(end._text, 120);
    if (txt) pieces.push(`Ended with: ${txt}`);
  }

  return pieces.join(" ");
}

