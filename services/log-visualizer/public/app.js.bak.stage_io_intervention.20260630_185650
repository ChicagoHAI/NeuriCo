  wireEvidenceDelegation();
  userEmail = localStorage.getItem(EMAIL_KEY) || null;
  currentScreen = userEmail ? "list" : "entry";
  renderApp();
  watchWorldModel();   // poll build status: shows the bottom progress bar and auto-reloads when a build finishes
}

init().catch((error) => {
  root.innerHTML = `<section class="panel"><h3>Failed to load</h3><pre>${escapeHtml(error.stack || error.message)}</pre></section>`;
});
