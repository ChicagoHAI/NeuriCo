// Clean human-readable Trajectory renderer.
// This is the active annotator-facing view.
// It uses real NeuriCo events, but hides internal terms.
// ---------------------------------------------------------------------------

function cleanHumanText(value, n = 260) {
  let text = String(value || "")
    .replace(/Reading prompt from stdin\.\.\./gi, "")
    .replace(/Agent Message:/gi, "")
    .replace(/\{[^{}]{0,300}\}/g, "")
    .replace(/\b(record_format|record_type|source_family|agent_message|search_result)\b/gi, "")
    .replace(/\b(experiment_execution|literature_search|resource_finder|execution_transcript)\b/gi, "")
    .replace(/\s+/g, " ")
    .trim();

  if (!text) return "";
  return text.length <= n ? text : `${text.slice(0, n - 1)}…`;
}

function cleanPhaseName(value) {
  const key = String(value || "unknown");
  return {
    experiment_execution: "Running experiments",
    literature_search: "Searching papers",
    planning: "Planning",
    analysis: "Analyzing results",
    interpretation: "Interpreting findings",
    report_writing: "Writing report",
    implementation: "Writing code",
    execution: "Running tools",
    hypothesis: "Forming research claim",
    idea: "Understanding task",
    other: "Other work",
    unknown: "Other work",
  }[key] || key.replaceAll("_", " ");
}

function cleanAgentName(value) {
  const key = String(value || "unknown");
  return {
    execution: "Experiment runner",
    resource_finder: "Paper search helper",
    planner: "Planner",
    reviewer: "Reviewer",
    writer: "Report writer",
    user: "User",
    assistant: "Research agent",
    unknown: "NeuriCo",
  }[key] || key.replaceAll("_", " ");
}

function cleanCandidateName(value) {
  const key = String(value || "review_point");
  return {
    critical_decision: "Important decision",
    user_update_opportunity: "User update point",
    interruption_opportunity: "Stop-and-check point",
    missing_information: "Missing information",
    uncertainty_not_surfaced: "Unclear uncertainty",
    crux_for_user_decision: "Key question for the user",
    feedback_incorporation_check: "Feedback follow-through check",
  }[key] || key.replaceAll("_", " ");
}

function cleanBuildRunParts(data, candidates) {
  const events = trNormalizeEvents(data);
  const eventToCandidate = {};

  for (const candidate of candidates || []) {
    for (const eid of candidate.evidenceEventIds || []) {
      eventToCandidate[eid] ||= [];
      eventToCandidate[eid].push(candidate);
    }
  }

  const parts = [];
  let current = null;

  for (const event of events) {
    const stageType = trClassifyStage(event);
    const key = `${stageType}::${event._phase}::${event._agent}`;

    if (!current || current.key !== key) {
      if (current) parts.push(current);
      current = {
        id: `P${String(parts.length + 1).padStart(3, "0")}`,
        key,
        stageType,
        phase: event._phase,
        agent: event._agent,
        startIndex: event._index,
        endIndex: event._index,
        events: [],
        candidates: [],
      };
    }

    current.endIndex = event._index;
    current.events.push(event);

    for (const candidate of eventToCandidate[event._id] || []) {
      if (!current.candidates.find((x) => x.candidateId === candidate.candidateId)) {
        current.candidates.push(candidate);
      }
    }
  }

  if (current) parts.push(current);

  for (const part of parts) {
    const keyEvents = [...part.events]
      .sort((a, b) => trImportanceScore(b) - trImportanceScore(a) || a._index - b._index)
      .slice(0, 4);

    part.keyEvents = keyEvents;
    part.warningCount = trStageWarnings(part.events).length;
    part.priority = part.candidates.length * 2 + part.warningCount * 3 + keyEvents.reduce((sum, e) => sum + trImportanceScore(e), 0);

    const readable = keyEvents
      .map((event) => cleanHumanText(event._text, 160))
      .filter(Boolean)
      .slice(0, 2)
      .join("; ");

    part.summary = readable
      ? `NeuriCo worked on this part for ${part.events.length} saved step(s). Main signals: ${readable}`
      : `NeuriCo worked on this part for ${part.events.length} saved step(s).`;
  }

  return parts;
}

function cleanGoal(story, data) {
  const titleText = document.querySelector("#run-title")?.textContent?.trim();
  const raw = cleanHumanText(story?.taskGoal || "", 320);

  if (raw && raw.length > 40 && !/stdin|record_|source_family|agent_message/i.test(raw)) return raw;
  if (titleText && titleText !== "Loading...") return `Research task: ${titleText}.`;
  return "Review this NeuriCo research run and understand how it moved from the initial task to final evidence and results.";
}

function cleanOutcome(story) {
  const raw = cleanHumanText(story?.finalOutcome || "", 320);
  if (raw && raw.length > 40 && !/search result|record_|source_family|transcript/i.test(raw)) return raw;
