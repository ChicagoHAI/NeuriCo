let run = null;
let currentView = "overview";
let selectedArtifact = null;
let selectedFlowNodeId = null;
let decisionLayerFilter = "all";        // v3: filter by finding-lifecycle layer
let expandedFindings = new Set();        // v3: groups are COLLAPSED by default; this tracks the expanded ones
let showRoutine = false;                 // v3: default-hide medium/low importance ("routine") decisions
let showAllFindings = false;             // v3: default-hide routine (non-claim-level) findings + their decision groups
let searchQuery = "";                    // keyword-search page query (searches ALL decisions)
let canonicalTrajectory = null;        // data-layer canonical trajectory for Events tab
let canonicalTrajectoryRunId = null;
let eventPhaseFilter = "";
let eventAgentFilter = "";
let eventSearchQuery = "";

// Whether the run carries a finding-filter overlay (any finding has show_by_default). When
// it doesn't (older runs), every finding is treated as visible — fail-open to old behavior.
function hasFindingFilter() {
  const findings = (run && run.researchState && run.researchState.findings) || [];
  return findings.some((finding) => typeof finding.show_by_default === "boolean");
}

// A finding is visible when the toggle is on, the run has no filter, or the filter marked
// it claim-level. (show_by_default !== false → fail-open for any finding the filter missed.)
function findingVisible(finding) {
  return showAllFindings || !hasFindingFilter() || (finding && finding.show_by_default !== false);
}

// ---- Platform shell state (multi-run + per-user) ----
let userEmail = null;          // self-asserted identity (label, not auth)
let currentRunId = null;       // which run is open; null while on entry/list
let currentScreen = "entry";   // "entry" | "list" | "viewer"
const EMAIL_KEY = "neurico-user-email";

// runId as a query suffix for run-scoped GET URLs (e.g. `${base}${runQuery()}`).
function runQuery(prefix = "&") {
  return currentRunId ? `${prefix}runId=${encodeURIComponent(currentRunId)}` : "";
}
// Attach run + user to a POST body so the server writes to the right run/user.
function withRun(body) {
  return { ...body, runId: currentRunId, user: userEmail };
}

const root = document.querySelector("#view-root");
const title = document.querySelector("#run-title");
const status = document.querySelector("#run-status");
const navButtons = [...document.querySelectorAll(".nav-item")];

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function renderTable(table, limit = Infinity) {
  if (!table?.columns?.length) return `<p class="muted">No table data found.</p>`;
  const rows = table.rows.slice(0, limit);
  return `
    <div class="table-wrap">
      <table>
        <thead>
          <tr>${table.columns.map((column) => `<th>${escapeHtml(column)}</th>`).join("")}</tr>
        </thead>
        <tbody>
          ${rows.map((row) => `
            <tr>${table.columns.map((column) => `<td>${escapeHtml(row[column])}</td>`).join("")}</tr>
          `).join("")}
        </tbody>
      </table>
    </div>
  `;
}

// ---------------------------------------------------------------------------
// Annotation layer — agree/disagree + failure label + note on any decision
// subject, persisted to data/runs/<run-id>/annotations.json via /api/annotation.
// ---------------------------------------------------------------------------

function annotationFor(key) {
  return run.visualizerData?.annotations?.[key] || null;
}

function annotationCount() {
  return Object.keys(run.visualizerData?.annotations || {}).length;
}

// Renders an inline annotator widget. `snapshot` is the human-readable text of
// the subject, stored alongside the verdict so the JSONL is self-contained.
// The reviewer's two counterfactual calls — should the agent have informed the
// user, and should it have interrupted — graded independently as toggle pairs.
const ANNO_FIELDS = [
  { field: "informUser", options: [["inform", "inform user"], ["dont", "don't inform"]] },
  { field: "interrupt", options: [["interrupt", "interrupt"], ["dont", "don't interrupt"]] },
];

function annoToggleGroup(field, options, current) {
  return `<span class="anno-group" role="group">${options.map(([value, label]) =>
    `<button type="button" class="anno-toggle ${current === value ? "on" : ""}" data-anno-field="${field}" data-anno-value="${value}">${escapeHtml(label)}</button>`
  ).join("")}</span>`;
}

// Provenance tag for an option: what the agent did (chosen) vs. a real recorded
// alternative (evidence: artifact/transcript) vs. one the reconstruction invented.
function provenanceTag(status, source) {
  if (status === "chosen") return `<span class="prov chosen">✓ chosen</span>`;
  if (source === "inferred") return `<span class="prov inferred">inferred</span>`;
  return `<span class="prov evidence">evidence</span>`;
}

// Preference picker for a decision: chosen + alternatives + a free-text "your
// alternative" row, single-select (radio), NOTHING pre-selected — the reviewer
// must deliberately pick. Selection is the agree/disagree signal (no thumbs).
function renderPreferenceList(point, opts = {}) {
  const key = `dp:${point.id}`;
  const anno = annotationFor(key) || {};
  const raw = (point.options || []).filter((option) => option && option.text);
  const chosen = raw.filter((option) => option.status === "chosen");
  const alts = raw.filter((option) => option.status !== "chosen");
  const ordered = chosen.length ? [...chosen, ...alts]
    : [{ text: point.choice || decisionTitle(point), status: "chosen", source: null }, ...alts];
  let altIndex = 0;
  const rows = ordered.map((option) => {
    const value = option.status === "chosen" ? "chosen" : `alt:${altIndex++}`;
    const checked = anno.preferredOption === value ? "checked" : "";
    return `
      <label class="pref-row ${option.status === "chosen" ? "is-chosen" : ""}">
        <input type="radio" class="pref-radio" name="pref-${escapeHtml(key)}" data-pref-value="${value}" data-pref-text="${escapeHtml(option.text)}" ${checked}>
        <span class="pref-text">${escapeHtml(option.text)}</span>
        ${provenanceTag(option.status, option.source)}
      </label>`;
  }).join("");
  const customChecked = anno.preferredOption === "custom" ? "checked" : "";
  const custom = `
    <label class="pref-row pref-custom">
      <input type="radio" class="pref-radio" name="pref-${escapeHtml(key)}" data-pref-value="custom" ${customChecked}>
      <input type="text" class="pref-custom-input" placeholder="your alternative…" value="${escapeHtml(anno.customAlternative || "")}">
    </label>`;
  // Two DISTINCT skip verdicts, and they mean different things:
  //  • not_important   — a real fork, just low-stakes; triage, says nothing about extraction.
  //  • not_a_decision  — shouldn't have been extracted at all; an extractor false positive.
  // The not_a_decision rate is the signal for whether the extractor is too sensitive.
  const notImportantChecked = anno.preferredOption === "not_important" ? "checked" : "";
  const notDecisionChecked = anno.preferredOption === "not_a_decision" ? "checked" : "";
  const skips = `
    <label class="pref-row pref-skip">
      <input type="radio" class="pref-radio" name="pref-${escapeHtml(key)}" data-pref-value="not_important" ${notImportantChecked}>
      <span class="pref-text">⊘ Not important — a real fork, but low-stakes; skip it</span>
    </label>
    <label class="pref-row pref-skip pref-reject">
      <input type="radio" class="pref-radio" name="pref-${escapeHtml(key)}" data-pref-value="not_a_decision" ${notDecisionChecked}>
      <span class="pref-text">✕ Not a real decision — shouldn't have been extracted</span>
    </label>`;
  return `
    <div class="dp-prefs">
      ${rows}
      ${custom}
      ${opts.compact ? "" : skips}
    </div>`;
}

// Inform/interrupt toggles + note. Reads current values from the annotation; the
// persistence anchor is the enclosing [data-anno-key] card, not this widget.
function renderAnnotator(key, opts = {}) {
  const anno = annotationFor(key) || {};
  return `
    <div class="annotator">
      <div class="anno-row">
        ${ANNO_FIELDS.map(({ field, options }) => annoToggleGroup(field, options, anno[field])).join("")}
        <button class="anno-save" type="button">Save</button>
        <span class="anno-saved" data-anno-status>${anno.updatedAt ? "saved" : ""}</span>
      </div>
      ${opts.compact ? "" : `<input class="anno-note" type="text" placeholder="reviewer note (optional)" value="${escapeHtml(anno.note || "")}">`}
    </div>
  `;
}

function cardAnnoValue(scope, field) {
  const on = scope.querySelector(`.anno-toggle.on[data-anno-field="${field}"]`);
  return on ? on.dataset.annoValue : null;
}

// Persist everything for one card (decision or reviewer-flag) to its annotation.
async function persistCard(scope) {
  if (!scope) return;
  const prefRadio = scope.querySelector(".pref-radio:checked");
  const customInput = scope.querySelector(".pref-custom-input");
  const preferredOption = prefRadio?.dataset.prefValue || null;
  const payload = {
    key: scope.dataset.annoKey,
    subjectKind: scope.dataset.annoKind,
    snapshot: scope.dataset.annoSnapshot,
    informUser: cardAnnoValue(scope, "informUser"),
    interrupt: cardAnnoValue(scope, "interrupt"),
    note: scope.querySelector(".anno-note")?.value || "",
    preferredOption,
    preferredText: preferredOption === "custom"
      ? (customInput?.value || "")
      : (prefRadio?.dataset.prefText || null),
    customAlternative: customInput?.value || "",
  };
  const response = await fetch("/api/annotation", {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify(withRun(payload)),
  });
  run.visualizerData.annotations = await response.json();
  const status = scope.querySelector("[data-anno-status]");
  if (status) status.textContent = "saved";
  if (scope.dataset.annoKind === "decision_point") {
    scope.classList.toggle("unreviewed", !preferredOption);
    updateReviewProgress();
  }
}

// Count of decisions the reviewer has expressed a preference on (= reviewed).
function reviewedCount() {
  const annotations = run.visualizerData?.annotations || {};
  return decisionPoints().filter((point) => annotations[`dp:${point.id}`]?.preferredOption).length;
}
function updateReviewProgress() {
  const el = document.querySelector("[data-review-progress]");
  if (el) el.textContent = `${reviewedCount()} / ${decisionPoints().length} reviewed`;
}

// One delegated listener set on #view-root, attached once. Survives re-renders.
// All controls persist to the nearest [data-anno-key] card.
function wireAnnotationDelegation() {
  root.addEventListener("click", async (event) => {
    const saveBtn = event.target.closest(".anno-save");
    if (saveBtn) {
      const scope = saveBtn.closest("[data-anno-key]");
      saveBtn.disabled = true;
      await persistCard(scope);
      const status = scope.querySelector("[data-anno-status]");
      if (status) status.textContent = "saved ✓";
      saveBtn.disabled = false;
      return;
    }
    const button = event.target.closest(".anno-toggle");
    if (!button) return;
    const scope = button.closest("[data-anno-key]");
    const field = button.dataset.annoField;
    const already = button.classList.contains("on");
    scope.querySelectorAll(`.anno-toggle[data-anno-field="${field}"]`).forEach((entry) => {
      entry.classList.toggle("on", entry === button && !already);
    });
    await persistCard(scope);
  });
  root.addEventListener("change", async (event) => {
    const radio = event.target.closest(".pref-radio");
    if (!radio) return;
    await persistCard(radio.closest("[data-anno-key]"));
  });
  root.addEventListener("input", (event) => {
    const custom = event.target.closest(".pref-custom-input");
    if (!custom) return;
    // typing your own alternative selects the custom row
    const scope = custom.closest("[data-anno-key]");
    const customRadio = scope.querySelector('.pref-radio[data-pref-value="custom"]');
    if (customRadio) customRadio.checked = true;
  });
  root.addEventListener("keydown", async (event) => {
    if (event.key !== "Enter") return;
    const field = event.target.closest(".anno-note, .pref-custom-input");
    if (!field) return;
    await persistCard(field.closest("[data-anno-key]"));
    field.blur();
  });
  root.addEventListener("blur", async (event) => {
    const field = event.target.closest?.(".anno-note, .pref-custom-input");
    if (!field) return;
    await persistCard(field.closest("[data-anno-key]"));
  }, true);
}

function decisionPoints() {
  return run.decisionPoints || [];
}

// Reconstruction sometimes drops a category token (a reviewer-question key or a
// shouldEngageReason) into the decision's `question` field instead of a real
// question — a field-name collision. When that happens the title is a useless
// one-word "crux"/"validity_risk"; fall back to the actual choice text.
const DECISION_TITLE_TOKENS = new Set([
  "crux", "uncertainty", "interrupt", "update_user", "feedback",
  "scope_choice", "validity_risk", "cost_risk", "human_preference",
  "irreversible_action", "routine_no", "decision",
]);
function decisionTitle(point) {
  const raw = (point.title || "").trim();
  if (!raw || DECISION_TITLE_TOKENS.has(raw.toLowerCase().replace(/[\s?]+$/, ""))) {
    return point.choice || raw || "Decision";
  }
  return raw;
}

// Render a world-model section whose rows are arrays (e.g. the leaderboard).
function allErrors() {
  return run.visualizerData?.errorState?.errors || [];
}

function flowNodeTitle(nodeId) {
  const node = (run.visualizerData?.flowElements || []).find((entry) => entry.id === nodeId);
  return node?.title || nodeId;
}

function decisionSnapshot(point) {
  const layer = point.layer ? `[${LAYER_LABEL[point.layer] || point.layer}] ` : "";
  return `${layer}${decisionTitle(point)} — ${point.situation || ""}`.slice(0, 400);
}

function worldEntity(id) {
  return (run.worldModelGraph?.items || []).find((item) => item.id === id) || null;
}

function entityGaps(id) {
  return (run.worldModelGraph?.gaps || []).filter((gap) => gap.entityId === id);
}

function relationLabel(relation) {
  return String(relation || "related to").replaceAll("_", " ");
}

function shortEntitySummary(entity) {
  const summary = entity?.summary || entity?.id || "Unknown entity";
  return summary.length > 110 ? `${summary.slice(0, 107)}...` : summary;
}

function renderEvidenceChain(entityId, includeEvidence = true) {
  const entity = worldEntity(entityId);
  if (!entity) return "";
  const outgoing = entity.links || [];
  const incoming = entity.incoming || [];
  const gaps = entityGaps(entityId);
  const evidence = includeEvidence ? (entity.evidence || []).filter((ref) => ref.path) : [];
  if (!outgoing.length && !incoming.length && !gaps.length && !evidence.length) return "";
  return `
    <div class="entity-chain">
      <span class="entity-chain-label">Evidence chain</span>
      <div class="entity-chain-links">
        ${incoming.map((link) => {
          const source = worldEntity(link.source);
          return `<span class="entity-link" title="${escapeHtml(link.rationale || "")}"><strong>${escapeHtml(link.source)}</strong> ${escapeHtml(relationLabel(link.relation))} this <small>${escapeHtml(link.basis || "")}</small><span>${escapeHtml(shortEntitySummary(source))}</span></span>`;
        }).join("")}
        ${outgoing.map((link) => {
          const target = worldEntity(link.target);
          return `<span class="entity-link" title="${escapeHtml(link.rationale || "")}">This ${escapeHtml(relationLabel(link.relation))} <strong>${escapeHtml(link.target)}</strong> <small>${escapeHtml(link.basis || "")}</small><span>${escapeHtml(shortEntitySummary(target))}</span></span>`;
        }).join("")}
        ${gaps.map((gap) => `<span class="entity-gap">Missing link: ${escapeHtml(gap.message)}</span>`).join("")}
      </div>
      ${evidence.length ? `<div class="entity-sources">${evidence.slice(0, 4).map((ref) => `<button class="dp-ref" data-evidence="${escapeHtml(ref.path)}"${ref.anchor ? ` data-evidence-anchor="${escapeHtml(ref.anchor)}"` : ""}${ref.itemId ? ` data-evidence-line="${escapeHtml(ref.itemId)}"` : ""}>${escapeHtml(ref.path)}${ref.itemId ? ` · ${escapeHtml(ref.itemId)}` : ""}</button>`).join("")}</div>` : ""}
    </div>`;
}

const IMPORTANCE_RANK = { critical: 4, high: 3, medium: 2, low: 1 };
const IMPORTANCE_TONE = { critical: "danger", high: "warn", medium: "review", low: "muted" };

// v3 spine: the four layers of a finding's decision chain, in lifecycle order.
const LAYER_ORDER = { hypothesis: 0, method: 1, experiment_design: 2, interpretation: 3 };
const HIGH_LEVEL_LAYERS = new Set(["hypothesis", "experiment_design", "interpretation"]);
// Shared ordering for the decisions-page groups AND the front-page top-3 — so the front
// page is exactly the top of the decisions page's "Project-wide" group (one source of truth).
// IMPORTANCE first (decisions are ordered by importance), then layer as a tiebreak — so the
// visible (high/critical) decisions are always at the top of a group and "show routine"
// only appends below them. (Layer-first wrongly floated low-importance hypothesis forks
// above high-importance interpretation ones.)
const sortInGroup = (a, b) =>
  (IMPORTANCE_RANK[b.importance] || 0) - (IMPORTANCE_RANK[a.importance] || 0) ||
  (LAYER_ORDER[a.layer] ?? 9) - (LAYER_ORDER[b.layer] ?? 9) ||
  a.clock - b.clock;
// Within a FINDING section: the causal sequence assigned by the graph/sequence review
// (lower = earlier in the reasoning chain that built the finding). Importance is NOT a
// sort key here — it only controls visibility (medium/low hidden by default), so the
// shown decisions read top-to-bottom as the run's actual reasoning. Falls back to
// layer-lifecycle order, then clock, for any decision the review didn't sequence.
const sortBySequence = (a, b) =>
  ((a.sequence ?? Number.MAX_SAFE_INTEGER) - (b.sequence ?? Number.MAX_SAFE_INTEGER)) ||
  (LAYER_ORDER[a.layer] ?? 9) - (LAYER_ORDER[b.layer] ?? 9) ||
  a.clock - b.clock;
const LAYER_LABEL = {
  hypothesis: "Hypothesis", method: "Method",
  experiment_design: "Experiment design", interpretation: "Interpretation",
};
const LAYER_TONE = {
  hypothesis: "review", method: "muted",
  experiment_design: "warn", interpretation: "danger",
};

// Cross-links: a decision abstracts the same log items as flow nodes, plus the raw
// evidence files (opened in the drawer).
function renderDecisionLinks(point) {
  const flow = (point.relatedFlowNodes || []).filter(Boolean);
  const files = (point.sourceRefs || []).filter((ref) => ref.file || ref.path);
  const entityChain = renderEvidenceChain(point.id, false);
  if (!flow.length && !files.length && !entityChain) return "";
  return `
    ${flow.length || files.length ? `<div class="dp-links">
      ${flow.map((id) => `<button class="dp-link flow" data-jump-flow="${escapeHtml(id)}">⬡ ${escapeHtml(flowNodeTitle(id))}</button>`).join("")}
      ${files.map((ref) => {
        const filePath = ref.file || ref.path;
        // Highlight target in the opened file: the evidence's own anchor (best,
        // populated on rebuild), else the chosen option text (often verbatim code),
        // else the chosen summary.
        const anchor = ref.anchor || point.choiceVerbatim || point.choice || "";
        return `<button class="dp-ref" data-evidence="${escapeHtml(filePath)}"${anchor ? ` data-evidence-anchor="${escapeHtml(anchor)}"` : ""}${ref.itemId ? ` data-evidence-line="${escapeHtml(ref.itemId)}"` : ""}>${escapeHtml(filePath)}${ref.itemId ? ` · ${escapeHtml(ref.itemId)}` : ""}</button>`;
      }).join("")}
    </div>` : ""}
    ${entityChain}
  `;
}

// Shared decision card with an inline preference picker + annotator. The card
// itself is the annotation scope (data-anno-key). It's "unreviewed" until the
// The finding (F-id) a decision belongs to, as a chip — shown on every decision box so the
// finding is clear even where decisions aren't grouped (e.g. the front page). The finding's
// text rides along as a hover tooltip. "global" decisions read as "Project-wide".
function findingBadge(finding) {
  if (!finding) return "";
  if (finding === "global") return `<span class="dp-finding-badge global">Project-wide</span>`;
  const fs = (run && run.researchState && run.researchState.findings) || [];
  const match = fs.find((f) => f.id === finding);
  const tip = match ? (match.text || "") : "";
  return `<span class="dp-finding-badge" title="${escapeHtml(tip)}">${escapeHtml(finding)}</span>`;
}

// human picks a preferred option.
function renderDecisionCard(point, opts = {}) {
  const compact = opts.compact === true;
  const key = `dp:${point.id}`;
  const reviewed = Boolean(annotationFor(key)?.preferredOption);
  // Show the "in the paper" pane whenever a highlight resolved for this decision (the v3
  // rubrics carry the paper anchor in evidence, not paperRef). Compact (front page) and
  // opts.paper === false both suppress it.
  const hasPaper = !compact && opts.paper !== false && (Boolean(point.paperRef) || Boolean(paperHighlightFor(point.id)));
  return `
    <article class="decision-card ${compact ? "compact" : ""} ${hasPaper ? "has-paper" : ""} ${point.shouldEngage ? "engage" : ""} ${reviewed ? "" : "unreviewed"}"
      data-anno-key="${escapeHtml(key)}" data-anno-kind="decision_point" data-anno-snapshot="${escapeHtml(decisionSnapshot(point))}">
      <div class="dp-main">
        <div class="dp-head">
          <span class="dp-id-badge">${escapeHtml(point.id)}</span>
          ${point.layer ? `<span class="dp-question ${LAYER_TONE[point.layer] || "muted"}">${escapeHtml(LAYER_LABEL[point.layer] || point.layer)}</span>` : ""}
          ${findingBadge(point.finding)}
          ${compact ? "" : `
            <span class="clock-badge">t${point.clock}</span>
            ${point.importance ? `<span class="dp-importance reviewer-only ${IMPORTANCE_TONE[point.importance] || "muted"}">${escapeHtml(point.importance)}</span>` : ""}
            <span class="dp-flag reviewer-only ${point.shouldEngage ? "danger" : "ok"}">${point.shouldEngage ? "ran solo · should pause" : "ran solo · ok to proceed"}</span>
            <span class="dp-origin">${escapeHtml(point.decisionType || "decision")}</span>`}
        </div>
        <h3>${escapeHtml(decisionTitle(point))}</h3>
        ${!compact && point.situation ? `<p>${escapeHtml(point.situation)}</p>` : ""}
        ${renderPreferenceList(point, { compact })}
        ${compact ? "" : `
          ${point.crux ? `<p class="dp-line reviewer-only"><strong>Crux:</strong> ${escapeHtml(point.crux)}</p>` : ""}
          ${point.uncertainty ? `<p class="dp-line reviewer-only"><strong>Surface:</strong> ${escapeHtml(point.uncertainty)}</p>` : ""}
          ${point.rationale ? `<p class="dp-line muted reviewer-only"><strong>Agent's reason:</strong> ${escapeHtml(point.rationale)}</p>` : ""}
          ${point.reviewer?.rationale ? `<p class="dp-line review reviewer-only"><strong>Why this importance:</strong> ${escapeHtml(point.reviewer.rationale)}</p>` : ""}
          ${renderDecisionLinks(point)}`}
        ${renderAnnotator(key, { compact })}
      </div>
      ${hasPaper ? renderPaperPane(point) : ""}
    </article>
  `;
}

// The right-hand "where this decision lives in the paper" pane. Filled lazily by
// wirePaperPanes() when it scrolls into view — see paper-highlight helpers below.
function renderPaperPane(point) {
  const hl = paperHighlightFor(point.id);
  const section = point.paperRef?.section || hl?.section || "the paper";
  return `
    <aside class="dp-paper" data-paper-decision="${escapeHtml(point.id)}">
      <div class="dp-paper-head">
        <span class="dp-paper-tag">📄 In the paper</span>
        <span class="dp-paper-section">${escapeHtml(section)}</span>
      </div>
      <div class="dp-paper-view" data-paper-view><div class="dp-paper-loading muted">Loading paper…</div></div>
    </aside>`;
}

// Wire the cross-link buttons inside the current view (evidence is global).
function wireDecisionLinks() {
  root.querySelectorAll("[data-jump-flow]").forEach((element) => {
    element.addEventListener("click", () => {
      selectedFlowNodeId = element.dataset.jumpFlow;
      currentView = "flow";
      render();
    });
  });
}

// Build a <pre> whose first occurrence of `anchor` is wrapped in <mark>, so the
// drawer can point at the exact code/line a decision is about — not just the file.
// Escapes first (XSS-safe), then injects the marker into the escaped text.
function highlightedPre(content, anchor) {
  const escaped = escapeHtml(content || "");
  const needle = escapeHtml((anchor || "").trim());
  if (needle && needle.length >= 3) {
    const at = escaped.indexOf(needle);
    if (at !== -1) {
      const marked = escaped.slice(0, at) + `<mark class="evidence-hit">${needle}</mark>` + escaped.slice(at + needle.length);
      return `<pre>${marked}</pre>`;
    }
  }
  return `<pre>${escaped}</pre>`;
}

function lineFocusedPre(content, itemId) {
  const match = String(itemId || "").match(/^L(\d+)$/);
  if (!match) return "";
  const lineNumber = Number(match[1]);
  const lines = String(content || "").split(/\r?\n/);
  if (lineNumber < 1 || lineNumber > lines.length) return "";
  const start = Math.max(1, lineNumber - 3);
  const end = Math.min(lines.length, lineNumber + 3);
  const excerpt = [];
  for (let number = start; number <= end; number += 1) {
    excerpt.push(`<span class="evidence-line${number === lineNumber ? " focus" : ""}"><b>${number}</b>${escapeHtml(lines[number - 1])}</span>`);
  }
  return `<pre class="evidence-lines">${excerpt.join("\n")}</pre>`;
}

// Evidence drawer — the click-through replacement for the old Artifacts tab.
// Any element with data-evidence="<path>" opens the file here; an optional
// data-evidence-anchor="<snippet>" scrolls to and highlights that snippet.
async function openEvidence(filePath, anchor = "", itemId = "") {
  if (!filePath) return;
  let drawer = document.querySelector("#evidence-drawer");
  if (!drawer) {
    drawer = document.createElement("div");
    drawer.id = "evidence-drawer";
    drawer.innerHTML = `
      <div class="evidence-backdrop" data-evidence-close></div>
      <aside class="evidence-panel">
        <header class="evidence-head">
          <span class="evidence-path"></span>
          <button class="evidence-close" data-evidence-close aria-label="Close">✕</button>
        </header>
        <div class="evidence-body"></div>
      </aside>
    `;
    document.body.appendChild(drawer);
    drawer.addEventListener("click", (event) => {
      if (event.target.closest("[data-evidence-close]")) closeEvidence();
    });
  }
  drawer.classList.add("open");
  drawer.querySelector(".evidence-path").textContent = filePath;
  const body = drawer.querySelector(".evidence-body");
  body.innerHTML = `<pre>Loading…</pre>`;
  try {
    const response = await fetch(`/api/artifact?path=${encodeURIComponent(filePath)}${runQuery()}`);
    const artifact = await response.json();
    if (artifact.previewType === "image") {
      body.innerHTML = `<img src="${artifact.url}" alt="${escapeHtml(filePath)}">`;
    } else if (artifact.extension === ".pdf" || artifact.previewType === "binary") {
      body.innerHTML = `<iframe src="${artifact.url}" title="${escapeHtml(filePath)}"></iframe>`;
    } else if (artifact.previewType === "csv") {
      body.innerHTML = renderTable(artifact.csv, 300);
    } else {
      body.innerHTML = lineFocusedPre(artifact.content || "", itemId) || highlightedPre(artifact.content || "", anchor);
      body.querySelector(".evidence-hit")?.scrollIntoView({ block: "center" });
    }
  } catch {
    body.innerHTML = `<pre>Could not load ${escapeHtml(filePath)}</pre>`;
  }
}

function closeEvidence() {
  document.querySelector("#evidence-drawer")?.classList.remove("open");
}

// Whiteboard — orientation only. A reviewer should skim this in under a minute
// and know what the run is, what it found, the biggest risk, and how much to
// trust it. Grading happens on Decisions / Errors, not here.
// ---------------------------------------------------------------------------
// Whiteboard (paper-reading layout): a reviewer skims it like a paper —
// Abstract → Hypotheses (NeuriCo's reasoning) → Methodology + Figure →
// Results → Conclusion + Future work — with a thin review rail (trust + jumps).
// Content stays reconstruction-grounded; it is not the run's own REPORT.md.
// ---------------------------------------------------------------------------

// First sentence of a blob, for one-line headlines/verdicts.
function firstSentence(text) {
  const clean = String(text || "").trim();
  if (!clean) return "";
  const match = clean.match(/^.*?[.!?](?:\s|$)/);
  return (match ? match[0] : clean).trim();
}

function renderWhiteboard() {
  // v3 front page (the quick-annotation gate): abstract + the top findings, each with
  // its single highest-stakes decision, inline-annotatable. The full paper and the full
  // decisions list are one click away — everything else lives on the Decisions page.
  if (!run.researchState) {
    root.innerHTML = `
      <section class="panel flow-empty">
        <h3>Front page not generated yet</h3>
        <p class="muted">It is built by the world-model reconstruction. It appears here once that finishes — watch the bar at the bottom, or check the terminal.</p>
      </section>`;
    return;
  }
  const ws = run.researchState || {};
  const title = ws.title || "";
  const abstract = ws.abstract || ws.narrative || "";
  const headline = ws.headline || firstSentence(ws.currentBest);
  const findings = ws.findings || [];
  const findingById = new Map(findings.map((finding) => [finding.id, finding]));
  const points = decisionPoints();
  const pointById = new Map(points.map((point) => [point.id, point]));

  // Right half: the reviewer's FRONT-PAGE picks — the ≤5 decisions a reviewer should
  // scrutinize (having read only the abstract) to decide whether to trust the run, chosen
  // by Pass 2 and ordered most-decisive first. Fall back to the top project-wide (then
  // top high-level) decisions by importance if no review has run.
  const reviewer = run.reviewSummary || null;
  let keyDecisions = (run.frontPageDecisions || [])
    .map((id) => pointById.get(id))
    .filter(Boolean)
    .slice(0, 5);
  if (!keyDecisions.length) {
    keyDecisions = points.filter((point) => point.finding === "global").sort(sortInGroup).slice(0, 5);
    if (!keyDecisions.length) {
      keyDecisions = points.filter((point) => HIGH_LEVEL_LAYERS.has(point.layer)).sort(sortInGroup).slice(0, 5);
    }
  }
  const verdict = reviewer?.runQuality || null;
  const VERDICT_TONE = { trustworthy: "ok", mixed: "warn", unconvincing: "danger" };

  root.innerHTML = `
    <div class="board-page wb-split">
      <section class="wb-left">
        <section class="panel wb-abstract">
          ${title ? `<h2 class="wb-title">${escapeHtml(title)}</h2>` : ""}
          <h3>📄 Abstract</h3>
          <p>${escapeHtml(abstract || "No abstract reconstructed.")}</p>
          ${headline ? `<p class="wb-headline"><strong>Headline:</strong> ${escapeHtml(headline)}</p>` : ""}
          <div class="wb-lite-actions">
            ${run.paperPdf ? `<button class="wb-jump-btn" data-open-paper>📄 Read the full paper</button>` : ""}
            <button class="wb-jump-btn decisions" data-jump-view="decisions">All decisions →</button>
          </div>
        </section>
        ${verdict ? `
          <section class="panel wb-verdict reviewer-only ${VERDICT_TONE[verdict.verdict] || "muted"}">
            <h3>🛡 Reviewer verdict: <span class="wb-verdict-label">${escapeHtml(verdict.verdict || "")}</span></h3>
            <p>${escapeHtml(verdict.rationale || "")}</p>
          </section>` : ""}
      </section>

      <section class="wb-right">
        <div class="decision-list">
          ${keyDecisions.length ? keyDecisions.map((decision) => renderDecisionCard(decision, { compact: true, paper: false })).join("") : `<p class="muted">No decisions reconstructed yet.</p>`}
        </div>
      </section>
    </div>
  `;

  root.querySelectorAll("[data-jump-view]").forEach((element) => {
    element.addEventListener("click", () => {
      currentView = element.dataset.jumpView;
      render();
    });
  });
  root.querySelector("[data-open-paper]")?.addEventListener("click", () => {
    const url = paperPdfUrl();
    if (url) window.open(url, "_blank");
  });
  wireDecisionLinks();
  wirePaperPanes();
}

function renderDecisions() {
  const points = decisionPoints();
  if (!points.length) {
    root.innerHTML = `
      <section class="panel flow-empty">
        <h3>Decisions not generated yet</h3>
        <p class="muted">Decisions are reconstructed by the world-model pass and grouped under the finding each one served. They appear here once that finishes.</p>
      </section>`;
    return;
  }

  // v3: decisions are organized by the FINDING they serve (the spine), then by LAYER
  // within (hypothesis → method → experiment_design → interpretation). The two filter
  // axes are layer and importance; there is no reviewer-question axis any more.
  const findings = (run.researchState && run.researchState.findings) || [];
  const findingById = new Map(findings.map((finding) => [finding.id, finding]));

  const layers = ["hypothesis", "method", "experiment_design", "interpretation"]
    .filter((value) => points.some((point) => point.layer === value));
  const countByLayer = (value) => points.filter((point) => point.layer === value).length;

  // Coverage in the data, brevity in the default view: every decision (incl. the
  // coding tail) is reconstructed, but only high/critical ("key") show by default;
  // medium/low ("routine") are hidden behind a toggle. importance is the load-bearing
  // signal here — the default annotation set is exactly the decisions worth a glance.
  // (Anything the default misses is reachable via the Search page.)
  const isKeyDecision = (point) => point.importance === "high" || point.importance === "critical";
  const routineCount = points.filter((point) => !isKeyDecision(point)).length;

  const activeLayer = decisionLayerFilter === "all" || layers.includes(decisionLayerFilter) ? decisionLayerFilter : "all";
  const passes = (point) =>
    (activeLayer === "all" || point.layer === activeLayer) &&
    (showRoutine || isKeyDecision(point));

  // Group order: PROJECT-WIDE first, then findings in F-order. (A decision whose finding
  // tag isn't a known finding id also falls into the global group.)
  const hasGlobal = points.some((point) => point.finding === "global" || (point.finding && !findingById.has(point.finding)));
  const groupIds = [];
  if (hasGlobal) groupIds.push("global");
  // Finding groups are gated by the finding filter (claim-level vs routine); the
  // project-wide group is always shown. A hidden finding's whole decision group collapses.
  for (const finding of findings) {
    if (!points.some((point) => point.finding === finding.id)) continue;
    if (findingVisible(finding)) groupIds.push(finding.id);
  }
  const hiddenFindingGroups = hasFindingFilter()
    ? findings.filter((finding) => finding.show_by_default === false && points.some((point) => point.finding === finding.id)).length
    : 0;

  const inGroup = (gid) => points
    .filter((point) => (findingById.has(gid) ? point.finding === gid : (point.finding === "global" || !findingById.has(point.finding))))
    .filter(passes)
    .sort(sortBySequence);

  // Count only decisions in VISIBLE finding groups (hidden groups collapse entirely).
  const shownCount = groupIds.reduce((sum, gid) => sum + inGroup(gid).length, 0);

  const filterRow = (label, key, values, active, valueLabel, counter) => `
    <div class="dp-filter-row">
      <span class="dp-filter-label">${escapeHtml(label)}</span>
      <button class="filter-chip ${active === "all" ? "on" : ""}" data-filter-key="${key}" data-filter-value="all">All</button>
      ${values.map((value) => `
        <button class="filter-chip ${active === value ? "on" : ""}" data-filter-key="${key}" data-filter-value="${escapeHtml(value)}">${escapeHtml(valueLabel(value))} <strong>${counter(value)}</strong></button>
      `).join("")}
    </div>`;

  const groupHtml = (gid) => {
    const groupPoints = inGroup(gid);
    if (!groupPoints.length) return "";
    const isGlobal = gid === "global";
    const finding = findingById.get(gid);
    const collapsed = !expandedFindings.has(gid);
    const reviewedHere = groupPoints.filter((point) => Boolean(annotationFor(`dp:${point.id}`)?.preferredOption)).length;
    const tags = isGlobal
      ? `<span class="dg-id">Project-wide</span>`
      : `<span class="dg-id">${escapeHtml(gid)}</span>${finding?.kind ? `<span class="dg-kind ${escapeHtml(finding.kind)}">${escapeHtml(finding.kind)}</span>` : ""}`;
    const headText = isGlobal
      ? "Decisions that shaped the whole run, tied to no single finding."
      : escapeHtml(finding?.text || "Finding");
    return `
      <section class="decision-group ${collapsed ? "collapsed" : ""}">
        <button class="dg-head" data-toggle-finding="${escapeHtml(gid)}">
          <span class="dg-caret">${collapsed ? "▸" : "▾"}</span>
          <span class="dg-head-main">
            <span class="dg-tags">${tags}<span class="dg-count">${reviewedHere}/${groupPoints.length} reviewed</span></span>
            <span class="dg-text">${headText}</span>
            ${!isGlobal && finding?.insight ? `<span class="dg-insight">${escapeHtml(finding.insight)}</span>` : ""}
          </span>
        </button>
        ${collapsed ? "" : `<div class="decision-list wide">${groupPoints.map(renderDecisionCard).join("")}</div>`}
      </section>`;
  };

  root.innerHTML = `
    <div class="decisions-page">
      <section class="review-hero compact">
        <div>
          <span class="eyebrow">Decisions</span>
          <h3>Every fork the run took — grouped by the finding it served</h3>
          <p>Grouped by the finding each served. By default you see only the <strong>key</strong> (high/critical) decisions — the routine coding tail is hidden but one click away. Pick the option you'd have taken, write your own, or flag it.</p>
        </div>
        <div class="dp-progress-badge">
          <strong data-review-progress>${reviewedCount()} / ${points.length} reviewed</strong>
        </div>
      </section>
      <div class="dp-controls">
        <div class="dp-filters">
          ${layers.length > 1 ? filterRow("Layer", "layer", layers, activeLayer, (value) => LAYER_LABEL[value] || value, countByLayer) : ""}
        </div>
        ${hiddenFindingGroups ? `<button class="routine-toggle ${showAllFindings ? "on" : ""}" data-toggle-findings>${showAllFindings ? "Hide" : "Show"} all findings <strong>${hiddenFindingGroups}</strong></button>` : ""}
        ${routineCount ? `<button class="routine-toggle ${showRoutine ? "on" : ""}" data-toggle-routine>${showRoutine ? "Hide" : "Show"} routine (medium/low) <strong>${routineCount}</strong></button>` : ""}
      </div>
      <p class="dp-showing muted">Showing <strong>${shownCount}</strong> of ${points.length} decisions${!showRoutine && routineCount ? ` · ${routineCount} routine hidden` : ""}${!showAllFindings && hiddenFindingGroups ? ` · ${hiddenFindingGroups} finding ${hiddenFindingGroups === 1 ? "group" : "groups"} hidden` : ""} across ${groupIds.length} ${groupIds.length === 1 ? "group" : "groups"}</p>
      ${groupIds.map(groupHtml).join("") || `<p class="muted">No decisions in this view.${!showRoutine && routineCount ? ` They may be routine — click “Show routine” above.` : ""}</p>`}
    </div>
  `;
  root.querySelectorAll("[data-filter-key]").forEach((element) => {
    element.addEventListener("click", () => {
      if (element.dataset.filterKey === "layer") decisionLayerFilter = element.dataset.filterValue;
      renderDecisions();
    });
  });
  root.querySelector("[data-toggle-routine]")?.addEventListener("click", () => {
    showRoutine = !showRoutine;
    renderDecisions();
  });
  root.querySelector("[data-toggle-findings]")?.addEventListener("click", () => {
    showAllFindings = !showAllFindings;
    renderDecisions();
  });
  root.querySelectorAll("[data-toggle-finding]").forEach((element) => {
    element.addEventListener("click", () => {
      const gid = element.dataset.toggleFinding;
      if (expandedFindings.has(gid)) expandedFindings.delete(gid);
      else expandedFindings.add(gid);
      renderDecisions();
    });
  });
  wireDecisionLinks();
  wirePaperPanes();
}

// ---- Paper highlight panes: decision ↔ paper_draft/main.pdf ----------------
// The build step (build_paper_highlights.py) resolves each decision's paperRef to a
// page + box; here we render that page with pdf.js and overlay the box. The whole
// feature is best-effort: if pdf.js or the PDF/highlight is missing, each pane
// degrades to a quote + "open paper" link. The PDF is loaded ONCE per run and reused.
const PDFJS_WORKER = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
let pdfDocPromise = null;

function paperPdfUrl() {
  return run?.paperPdf ? `/api/file?path=${encodeURIComponent(run.paperPdf)}${runQuery()}` : null;
}
function paperHighlightFor(decisionId) {
  return (run?.paperHighlights || {})[decisionId] || null;
}
function getPdfDoc() {
  if (pdfDocPromise) return pdfDocPromise;
  const lib = window.pdfjsLib;
  const url = paperPdfUrl();
  if (!lib || !url) return Promise.reject(new Error("pdf.js or paper PDF unavailable"));
  lib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
  pdfDocPromise = lib.getDocument(url).promise;
  return pdfDocPromise;
}

// Render panes only as they scroll into view — rendering every decision's PDF page
// up front would be brutal. Each pane renders once.
function wirePaperPanes() {
  const panes = [...root.querySelectorAll(".dp-paper[data-paper-decision]")];
  if (!panes.length) return;
  if (!paperPdfUrl() || !window.pdfjsLib) {
    panes.forEach((pane) => renderPaperFallback(pane, paperHighlightFor(pane.dataset.paperDecision)));
    return;
  }
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      obs.unobserve(entry.target);
      renderPaperHighlight(entry.target);
    });
  }, { rootMargin: "300px" });
  panes.forEach((pane) => observer.observe(pane));
}

// Render the WHOLE paper in the decision pane with page navigation — defaulting to
// the highlighted page, with the highlight box drawn only on its own page. This
// replaces the old single-page-only pane (which couldn't page through the paper).
async function renderPaperHighlight(pane) {
  const id = pane.dataset.paperDecision;
  const view = pane.querySelector("[data-paper-view]");
  const hl = paperHighlightFor(id);
  let doc;
  try {
    doc = await getPdfDoc();
  } catch (error) {
    renderPaperFallback(pane, hl);
    return;
  }
  const numPages = doc.numPages;
  const hlPage = (hl && hl.status !== "unresolved" && hl.page) ? hl.page : null;
  let current = hlPage || 1;

  view.innerHTML = `
    <div class="dp-paper-nav">
      <button class="dp-paper-pg" data-paper-prev aria-label="Previous page">‹</button>
      <span class="dp-paper-pageno" data-paper-pageno></span>
      <button class="dp-paper-pg" data-paper-next aria-label="Next page">›</button>
      ${hlPage ? `<button class="dp-paper-pg dp-paper-tohl" data-paper-tohl title="Jump to the highlighted passage">↪ highlight</button>` : ""}
    </div>
    <div class="dp-paper-canvas-host" data-paper-canvas-host></div>`;
  const host = view.querySelector("[data-paper-canvas-host]");
  const pageNoEl = view.querySelector("[data-paper-pageno]");
  const prevBtn = view.querySelector("[data-paper-prev]");
  const nextBtn = view.querySelector("[data-paper-next]");

  const renderPage = async (target) => {
    current = Math.min(Math.max(1, target), numPages);
    pageNoEl.textContent = `p${current} / ${numPages}`;
    prevBtn.disabled = current <= 1;
    nextBtn.disabled = current >= numPages;
    try {
      const page = await doc.getPage(current);
      const paneWidth = Math.max(view.clientWidth || 360, 240);
      const base = page.getViewport({ scale: 1 });
      const scale = paneWidth / base.width;
      const viewport = page.getViewport({ scale });
      // Render at device-pixel resolution so the page is crisp on Retina/HiDPI
      // displays (the canvas backing store is dpr× the CSS size).
      const dpr = window.devicePixelRatio || 1;
      const cssW = Math.floor(viewport.width);
      const cssH = Math.floor(viewport.height);
      const canvas = document.createElement("canvas");
      canvas.className = "dp-paper-canvas";
      canvas.width = Math.floor(cssW * dpr);
      canvas.height = Math.floor(cssH * dpr);
      canvas.style.width = `${cssW}px`;
      canvas.style.height = `${cssH}px`;
      await page.render({
        canvasContext: canvas.getContext("2d"),
        viewport,
        transform: dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : undefined,
      }).promise;

      const wrap = document.createElement("div");
      wrap.className = "dp-paper-canvas-wrap";
      wrap.style.width = `${cssW}px`;
      wrap.style.height = `${cssH}px`;
      wrap.appendChild(canvas);

      let firstTop = 0;
      if (current === hlPage) {
        (hl.rects || []).forEach((r, index) => {
          const box = document.createElement("div");
          box.className = `dp-paper-hl${hl.status === "section_only" ? " soft" : ""}`;
          box.style.left = `${r[0] * scale}px`;
          box.style.top = `${r[1] * scale}px`;
          box.style.width = `${Math.max((r[2] - r[0]) * scale, 4)}px`;
          box.style.height = `${Math.max((r[3] - r[1]) * scale, 8)}px`;
          wrap.appendChild(box);
          if (index === 0) firstTop = r[1] * scale;
        });
      }
      host.innerHTML = "";
      host.appendChild(wrap);
      host.scrollTop = current === hlPage ? Math.max(0, firstTop - 64) : 0;
    } catch (error) {
      host.innerHTML = `<p class="muted dp-paper-empty">Couldn't render p${current}.</p>`;
    }
  };

  prevBtn.addEventListener("click", () => renderPage(current - 1));
  nextBtn.addEventListener("click", () => renderPage(current + 1));
  view.querySelector("[data-paper-tohl]")?.addEventListener("click", () => renderPage(hlPage));
  renderPage(current);
}

function renderPaperFallback(pane, hl) {
  const id = pane.dataset.paperDecision;
  const view = pane.querySelector("[data-paper-view]");
  const url = paperPdfUrl();
  const point = decisionPoints().find((p) => p.id === id);
  const anchor = hl?.anchor || point?.paperRef?.anchor || "";
  if (!url) {
    view.innerHTML = `<p class="muted dp-paper-empty">Paper not available for this run.</p>`;
    return;
  }
  const page = hl?.page;
  const href = page ? `${url}#page=${page}` : url;
  const resolved = hl && hl.status && hl.status !== "unresolved";
  const note = resolved
    ? "Couldn't render the page inline."
    : "Mentioned in the paper, but the exact spot couldn't be pinpointed.";
  view.innerHTML = `
    ${anchor ? `<blockquote class="dp-paper-quote">${escapeHtml(anchor)}</blockquote>` : ""}
    <p class="muted dp-paper-empty">${note} <a href="${escapeHtml(href)}" target="_blank" rel="noopener">Open paper${page ? ` · p${page}` : ""} ↗</a></p>`;
}

// v3: the Flow tab is the run's scientific structure — hypotheses → the experiments that
// tested them → the findings they produced — as a collapsible OUTLINE (not a node canvas).
// Relationships are nesting + ✓/✗ badges, so there are no crossing edges at any scale.
let collapsedHyps = new Set();
const HYP_STATUS_TONE = {
  supported: "ok", refuted: "danger", uncertain: "warn", alive: "review", dead: "muted",
};

function renderFlow() {
  const ws = run.researchState || {};
  const hypotheses = ws.hypotheses || [];
  const experiments = ws.experiments || [];
  const findings = ws.findings || [];

  if (!hypotheses.length && !findings.length) {
    root.innerHTML = `
      <section class="panel flow-empty">
        <h3>Not generated yet</h3>
        <p class="muted">The hypotheses, experiments, and findings appear here once the world model is reconstructed — watch the bar at the bottom, or open the Whiteboard.</p>
      </section>`;
    return;
  }

  const hypById = new Map(hypotheses.map((h) => [h.id, h]));
  const expById = new Map(experiments.map((e) => [e.id, e]));

  // How many findings the filter hides (drives the "Show all findings" toggle). All H and
  // E stay drawn regardless — only finding rows collapse into a per-experiment "+N" badge.
  const hiddenFindingCount = hasFindingFilter()
    ? findings.filter((finding) => finding.show_by_default === false).length : 0;

  // Group findings by the hypothesis they SUPPORT/REFUTE. A finding can bear on SEVERAL
  // hypotheses, so it appears under EVERY one it links to (with that edge's own polarity) —
  // not just the first. (Earlier this took only the first link, which silently dropped a
  // finding from every hypothesis after the first — leaving later hypotheses looking empty.)
  // Within a hypothesis, findings sub-group by the experiment that produced them.
  const srLinks = (f) => (f.links || []).filter((l) => (l.relation === "supports" || l.relation === "refutes") && hypById.has(l.target));
  const expOf = (f) => { const p = (f.links || []).find((l) => l.relation === "produced_by" && expById.has(l.target)); return p ? p.target : null; };
  const byHyp = new Map();
  const orphanFindings = [];
  for (const f of findings) {
    const srs = srLinks(f);
    if (srs.length) {
      for (const sr of srs) {
        if (!byHyp.has(sr.target)) byHyp.set(sr.target, []);
        byHyp.get(sr.target).push({ f, polarity: sr.relation, exp: expOf(f) });
      }
    } else {
      orphanFindings.push({ f, polarity: null, exp: expOf(f) });
    }
  }

  // --- Tidy left-to-right tree: hypothesis → experiment → finding. Parents center on kids. ---
  const COL_X = { h: 16, e: 470, f: 970 };
  const CARD_W = { h: 430, e: 470, f: 720 };
  const ROW_H = 78; const CARD_H = 58; const TOP = 12; const HYP_GAP = 0.7;
  const trunc = (s, n) => { s = String(s || ""); return s.length > n ? s.slice(0, n - 1) + "…" : s; };

  const nodes = [];
  const links = [];
  let cursor = 0;

  // Place a group's findings (sub-grouped by their producing experiment) under parentKey;
  // return the experiment center rows so the parent can center on them.
  const placeGroup = (parentKey, items) => {
    const order = []; const seen = new Map();
    for (const it of items) {
      const k = it.exp || "_none";
      if (!seen.has(k)) { const g = { eid: k, fs: [] }; seen.set(k, g); order.push(g); }
      seen.get(k).fs.push(it);
    }
    const centers = [];
    for (const g of order) {
      // The H→E skeleton is built from ALL findings, so experiments never vanish when
      // findings are filtered. Only the finding ROWS collapse: place the visible ones,
      // then a single "+N hidden" badge row standing in for the routine ones.
      const fRows = [];
      const visible = g.fs.filter((it) => findingVisible(it.f));
      const hiddenCount = g.fs.length - visible.length;
      const ekey = "E:" + parentKey + ":" + g.eid;
      for (const it of visible) {
        // Key is unique PER PLACEMENT (a finding under two hypotheses is drawn twice, so a
        // bare F-id would collide in byKey and break edge routing).
        const fkey = ekey + ":" + it.f.id;
        nodes.push({ type: "f", key: fkey, row: cursor, f: it.f, polarity: it.polarity });
        links.push({ from: ekey, to: fkey, polarity: it.polarity });
        fRows.push(cursor); cursor += 1;
      }
      if (hiddenCount) {
        const mkey = "FMORE:" + ekey;
        nodes.push({ type: "f", key: mkey, row: cursor, more: hiddenCount });
        links.push({ from: ekey, to: mkey });
        fRows.push(cursor); cursor += 1;
      }
      const c = (fRows[0] + fRows[fRows.length - 1]) / 2;
      centers.push(c);
      nodes.push({ type: "e", key: ekey, row: c, e: expById.get(g.eid), eid: g.eid });
      links.push({ from: parentKey, to: ekey });
    }
    return centers;
  };

  const placeHyp = (h) => {
    const hkey = "H:" + h.id;
    const items = byHyp.get(h.id) || [];
    if (collapsedHyps.has(h.id) || !items.length) {
      nodes.push({ type: "h", key: hkey, row: cursor, h, empty: !items.length, collapsed: collapsedHyps.has(h.id) });
      cursor += 1 + HYP_GAP;
      return;
    }
    const centers = placeGroup(hkey, items);
    nodes.push({ type: "h", key: hkey, row: (centers[0] + centers[centers.length - 1]) / 2, h });
    cursor += HYP_GAP;
  };

  const placeOrphan = (items) => {
    const hkey = "H:_orphanF";
    const label = "Findings not linked to a hypothesis";
    if (collapsedHyps.has(hkey) || !items.length) {
      nodes.push({ type: "h", key: hkey, row: cursor, label, collapsed: collapsedHyps.has(hkey) });
      cursor += 1 + HYP_GAP;
      return;
    }
    const centers = placeGroup(hkey, items);
    nodes.push({ type: "h", key: hkey, row: (centers[0] + centers[centers.length - 1]) / 2, label });
    cursor += HYP_GAP;
  };

  for (const h of hypotheses) placeHyp(h);
  if (orphanFindings.length) placeOrphan(orphanFindings);

  const cyOf = (row) => row * ROW_H + TOP + CARD_H / 2;
  const byKey = new Map(nodes.map((n) => [n.key, n]));
  const W = COL_X.f + CARD_W.f + 24;
  const Hgt = Math.max(cursor, 1) * ROW_H + TOP + CARD_H;

  const edgePath = (ln) => {
    const a = byKey.get(ln.from); const b = byKey.get(ln.to);
    if (!a || !b) return "";
    const x1 = COL_X[a.type] + CARD_W[a.type]; const y1 = cyOf(a.row);
    const x2 = COL_X[b.type]; const y2 = cyOf(b.row);
    const mid = (x1 + x2) / 2;
    const cls = ln.polarity === "supports" ? "supports" : ln.polarity === "refutes" ? "refutes" : "neutral";
    return `<path class="tl ${cls}" d="M ${x1} ${y1} H ${mid} V ${y2} H ${x2}" />`;
  };

  const cardHtml = (n) => {
    const style = `left:${COL_X[n.type]}px;top:${n.row * ROW_H + TOP}px;width:${CARD_W[n.type]}px;`;
    if (n.type === "h") {
      const h = n.h; const tone = HYP_STATUS_TONE[(h && h.status)] || "muted";
      const label = n.label || (h && (h.statement || h.id)) || "";
      const toggleId = h ? h.id : n.key;
      return `<div class="tn tn-h" style="${style}" data-toggle-hyp="${escapeHtml(toggleId)}" title="${escapeHtml(label)}">
        <div class="tn-top"><span class="tn-caret">${n.collapsed ? "▸" : "▾"}</span>
          ${h ? `<span class="tn-id">${escapeHtml(h.id)}</span>` : ""}
          ${(h && h.status) ? `<span class="hg-status ${tone}">${escapeHtml(h.status)}</span>` : ""}</div>
        <div class="tn-h-text">${escapeHtml(trunc(label, 220))}</div>
        ${n.empty ? `<div class="tn-empty">no findings linked</div>` : ""}</div>`;
    }
    if (n.type === "e") {
      const e = n.e || {};
      return `<div class="tn tn-e" style="${style}" title="${escapeHtml(e.name || e.agent || n.eid)}">
        <div class="tn-e-name"><span class="tn-id">${escapeHtml(n.eid)}</span> ⚗ ${escapeHtml(trunc(e.name || e.agent || n.eid, 150))}</div>
        ${e.mode ? `<div class="tn-mode">${escapeHtml(String(e.mode).replace(/_/g, " "))}</div>` : ""}</div>`;
    }
    if (n.more) {
      return `<div class="tn tn-f more" style="${style}" data-show-all-findings title="Show ${n.more} hidden routine finding${n.more === 1 ? "" : "s"}">
        <span class="tn-id">+${n.more}</span>
        <span class="tn-f-text">${n.more} routine finding${n.more === 1 ? "" : "s"} hidden — click to show</span></div>`;
    }
    const f = n.f; const pol = n.polarity || "note";
    return `<div class="tn tn-f ${pol}" style="${style}" title="${escapeHtml(f.text || "")}">
      <span class="ho-badge ${pol}">${pol === "supports" ? "✓" : pol === "refutes" ? "✗" : "•"}</span>
      <span class="tn-id">${escapeHtml(f.id)}</span>
      <span class="tn-f-text">${escapeHtml(trunc(f.text || "", 260))}</span></div>`;
  };

  root.innerHTML = `
    <div class="flow-tree-page">
      <div class="flow-tree-head">
        <h3>Hypotheses → experiments → findings</h3>
        <p class="muted">${hypotheses.length} hypotheses · ${experiments.length} experiments · ${findings.length} findings · <span class="ho-badge supports">✓</span> supports · <span class="ho-badge refutes">✗</span> refutes · click a hypothesis to collapse${hiddenFindingCount ? ` · <strong>${hiddenFindingCount}</strong> routine hidden` : ""}</p>
        ${hiddenFindingCount ? `<button class="routine-toggle ${showAllFindings ? "on" : ""}" data-toggle-all-findings>${showAllFindings ? "Hide" : "Show"} all findings <strong>${hiddenFindingCount}</strong></button>` : ""}
      </div>
      <div class="flow-tree-scroll">
        <div class="flow-tree" style="width:${W}px;height:${Hgt}px">
          <svg class="flow-tree-edges" width="${W}" height="${Hgt}" aria-hidden="true">${links.map(edgePath).join("")}</svg>
          ${nodes.map(cardHtml).join("")}
        </div>
      </div>
    </div>`;

  root.querySelectorAll("[data-toggle-hyp]").forEach((el) => {
    el.addEventListener("click", () => {
      const id = el.dataset.toggleHyp;
      if (collapsedHyps.has(id)) collapsedHyps.delete(id); else collapsedHyps.add(id);
      renderFlow();
    });
  });
  const flowToggleAll = () => { showAllFindings = !showAllFindings; renderFlow(); };
  root.querySelector("[data-toggle-all-findings]")?.addEventListener("click", flowToggleAll);
  root.querySelectorAll("[data-show-all-findings]").forEach((el) => {
    el.addEventListener("click", () => { showAllFindings = true; renderFlow(); });
  });
}


// ---------------------------------------------------------------------------
// Events tab — native data-layer canonical trajectory view.
// This is the Month-1 evidence browser: all canonical events are accessible,
// with quick labels for user-update / interruption opportunities.
// ---------------------------------------------------------------------------

async function loadCanonicalTrajectory() {
  if (canonicalTrajectory && canonicalTrajectoryRunId === currentRunId) {
    return canonicalTrajectory;
  }

  const response = await fetch(`/api/canonical-run?runId=${encodeURIComponent(currentRunId)}`);
  if (!response.ok) {
    throw new Error(await response.text());
  }

  canonicalTrajectory = await response.json();
  canonicalTrajectoryRunId = currentRunId;
  return canonicalTrajectory;
}

async function saveEventAnnotation(eventId, eventIndex, action) {
  const response = await fetch("/api/annotations", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      runId: currentRunId,
      annotator: userEmail || "anonymous",
      annotationType: "canonical_event",
      eventId,
      eventIndex,
      labels: {
        should_update_user: action === "update" || action === "interrupt",
        interrupt_next_action: action === "interrupt",
        confidence: 3,
        annotator_rationale: `Demo label: ${action}`,
      },
    }),
  });

  const data = await response.json();
  if (!data.ok) {
    alert("Save failed");
    return;
  }

  alert("Annotation saved");
}

function eventMatchesFilters(event) {
  const haystack = [
    event.eventIndex,
    event.phase,
    event.agent,
    event.eventType,
    event.summary,
    event.rawPreview,
  ].join(" ").toLowerCase();

  return (!eventPhaseFilter || event.phase === eventPhaseFilter)
    && (!eventAgentFilter || event.agent === eventAgentFilter)
    && (!eventSearchQuery.trim() || haystack.includes(eventSearchQuery.trim().toLowerCase()));
}


function eventReadableText(event) {
  const parts = [
    event.summary,
    event.rawPreview,
    event.eventType,
  ].filter(Boolean).join(" ");

  return String(parts || "")
    .replace(/\s+/g, " ")
    .replace(/\\n/g, " ")
    .trim();
}

function eventShortTitle(event) {
  const text = eventReadableText(event);
  if (!text) return `${event.eventType || "event"} #${event.eventIndex}`;
  return text.length > 120 ? `${text.slice(0, 120)}…` : text;
}

function eventTags(event) {
  const text = eventReadableText(event).toLowerCase();
  const tags = [];

  if (/error|exception|traceback|failed|failure|not found|timeout|invalid/.test(text)) {
    tags.push(["risk", "possible issue"]);
  }
  if (/choose|decide|selected|baseline|model|method|threshold|split/.test(text)) {
    tags.push(["decision", "decision point"]);
  }
  if (/uncertain|unclear|maybe|possibly|likely|appears|not sure/.test(text)) {
    tags.push(["uncertain", "uncertainty"]);
  }
  if (/result|accuracy|metric|p=|confidence|bootstrap|significant|finding/.test(text)) {
    tags.push(["result", "result signal"]);
  }

  return tags;
}

function importantEventScore(event) {
  const text = eventReadableText(event).toLowerCase();
  let score = 0;

  if (/error|exception|traceback|failed|failure|not found|timeout|invalid/.test(text)) score += 5;
  if (/choose|decide|selected|baseline|model|method|threshold|split/.test(text)) score += 4;
  if (/uncertain|unclear|maybe|possibly|likely|appears|not sure/.test(text)) score += 3;
  if (/result|accuracy|metric|p=|confidence|bootstrap|significant|finding/.test(text)) score += 3;
  if (/write|report|abstract|paper|conclusion/.test(text)) score += 2;

  return score;
}

function compressTrajectorySegments(events) {
  const segments = [];

  for (const event of events || []) {
    const phase = event.phase || "unknown";
    const agent = event.agent || "unknown";
    const last = segments[segments.length - 1];

    if (last && last.phase === phase && last.agent === agent) {
      last.endIndex = event.eventIndex;
      last.count += 1;
      last.events.push(event);
    } else {
      segments.push({
        id: `segment-${segments.length + 1}`,
        phase,
        agent,
        startIndex: event.eventIndex,
        endIndex: event.eventIndex,
        count: 1,
        events: [event],
      });
    }
  }

  for (const segment of segments) {
    const scored = [...segment.events]
      .map((event) => ({ event, score: importantEventScore(event) }))
      .sort((a, b) => b.score - a.score || a.event.eventIndex - b.event.eventIndex);

    segment.keyEvents = scored
      .filter((item) => item.score > 0)
      .slice(0, 3)
      .map((item) => item.event);

    if (!segment.keyEvents.length) {
      segment.keyEvents = segment.events.slice(0, 2);
    }
  }

  return segments;
}

function renderTrajectoryGraph(events) {
  const segments = compressTrajectorySegments(events);
  const visibleSegments = segments.slice(0, 10);

  if (!visibleSegments.length) {
    return `<section class="events-viz-card"><p class="muted">No trajectory segments available.</p></section>`;
  }

  const nodeW = 220;
  const nodeH = 86;
  const gap = 52;
  const width = Math.max(900, visibleSegments.length * (nodeW + gap) + 80);
  const height = 190;

  return `
    <section class="events-viz-card events-graph-card">
      <div class="events-section-heading">
        <div>
          <span class="eyebrow">Trajectory graph</span>
          <h4>Compressed event-flow view</h4>
        </div>
        <p class="muted">${segments.length} compressed segment${segments.length === 1 ? "" : "s"}; showing first ${visibleSegments.length}.</p>
      </div>

      <div class="events-graph-scroll">
        <svg class="events-graph" viewBox="0 0 ${width} ${height}" width="${width}" height="${height}" role="img" aria-label="Canonical trajectory graph">
          <defs>
            <marker id="events-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,6 L9,3 z" fill="#64748b"></path>
            </marker>
          </defs>

          ${visibleSegments.map((segment, idx) => {
            const x = 40 + idx * (nodeW + gap);
            const y = 54;
            const fill = stableColor(segment.phase);
            return `
              ${idx > 0 ? `<line x1="${x - gap + 8}" y1="${y + nodeH / 2}" x2="${x - 10}" y2="${y + nodeH / 2}" stroke="#64748b" stroke-width="2" marker-end="url(#events-arrow)" />` : ""}
              <rect x="${x}" y="${y}" width="${nodeW}" height="${nodeH}" rx="14" fill="white" stroke="${fill}" stroke-width="3"></rect>
              <text x="${x + 16}" y="${y + 25}" font-size="13" font-weight="700" fill="#111827">${escapeHtml(segment.phase).slice(0, 24)}</text>
              <text x="${x + 16}" y="${y + 47}" font-size="12" fill="#4b5563">${escapeHtml(segment.agent).slice(0, 28)}</text>
              <text x="${x + 16}" y="${y + 68}" font-size="12" fill="#64748b">events ${escapeHtml(segment.startIndex)}–${escapeHtml(segment.endIndex)} · ${escapeHtml(segment.count)}</text>
            `;
          }).join("")}
        </svg>
      </div>
    </section>
  `;
}

function renderTrajectorySegments(events) {
  const segments = compressTrajectorySegments(events);

  return `
    <section class="events-viz-card">
      <div class="events-section-heading">
        <div>
          <span class="eyebrow">Trajectory segments</span>
          <h4>Human-readable run structure</h4>
        </div>
        <p class="muted">Each segment groups consecutive events with the same phase and agent.</p>
      </div>

      <div class="events-segment-grid">
        ${segments.slice(0, 8).map((segment, idx) => `
          <article class="events-segment-card">
            <div class="events-segment-top">
              <span class="events-step">Step ${idx + 1}</span>
              <span class="events-range">#${escapeHtml(segment.startIndex)}–${escapeHtml(segment.endIndex)}</span>
            </div>
            <h5>${escapeHtml(segment.phase)}</h5>
            <p class="muted">${escapeHtml(segment.agent)} · ${escapeHtml(segment.count)} event${segment.count === 1 ? "" : "s"}</p>

            <div class="events-key-list">
              ${segment.keyEvents.map((event) => `
                <button class="events-key-event" data-scroll-event="${escapeHtml(event.eventId)}">
                  <strong>#${escapeHtml(event.eventIndex)}</strong>
                  <span>${escapeHtml(eventShortTitle(event))}</span>
                </button>
              `).join("")}
            </div>
          </article>
        `).join("")}
      </div>
    </section>
  `;
}

function renderReadableEventCards(events) {
  const rows = events.filter(eventMatchesFilters);
  const important = rows
    .map((event) => ({ event, score: importantEventScore(event) }))
    .sort((a, b) => b.score - a.score || a.event.eventIndex - b.event.eventIndex);

  const prioritized = important.filter((item) => item.score > 0).slice(0, 40).map((item) => item.event);
  const fallback = rows.slice(0, 40);
  const visible = prioritized.length ? prioritized : fallback;

  return `
    <section class="events-viz-card">
      <div class="events-section-heading">
        <div>
          <span class="eyebrow">Annotation queue preview</span>
          <h4>Readable event cards</h4>
        </div>
        <p class="muted">${rows.length} matching events. Showing ${visible.length} prioritized readable cards.</p>
      </div>

      <div class="events-card-list">
        ${visible.map((event) => {
          const tags = eventTags(event);
          return `
            <article class="events-readable-card" id="event-card-${escapeHtml(event.eventId)}">
              <div class="events-readable-meta">
                <span>#${escapeHtml(event.eventIndex)}</span>
                <span>${escapeHtml(event.phase)}</span>
                <span>${escapeHtml(event.agent)}</span>
                <span>${escapeHtml(event.eventType)}</span>
              </div>

              <h5>${escapeHtml(eventShortTitle(event))}</h5>

              <div class="events-tag-row">
                ${tags.map(([kind, label]) => `<span class="events-tag ${escapeHtml(kind)}">${escapeHtml(label)}</span>`).join("") || `<span class="events-tag neutral">ordinary event</span>`}
              </div>

              <p class="events-readable-preview">${escapeHtml(event.rawPreview || event.summary || "").slice(0, 520)}</p>

              <div class="events-readable-actions">
                <button class="event-label-btn" data-action="update" data-event-id="${escapeHtml(event.eventId)}" data-event-index="${escapeHtml(event.eventIndex)}">inform user</button>
                <button class="event-label-btn" data-action="interrupt" data-event-id="${escapeHtml(event.eventId)}" data-event-index="${escapeHtml(event.eventIndex)}">interrupt</button>
                <button class="event-label-btn" data-action="none" data-event-id="${escapeHtml(event.eventId)}" data-event-index="${escapeHtml(event.eventIndex)}">no label</button>
              </div>
            </article>
          `;
        }).join("")}
      </div>
    </section>
  `;
}


function renderEventsTable(events) {
