// ---------------------------------------------------------------------------
// Human-facing product trajectory renderer.
// Default view is for annotators, not machines:
// - no raw logs by default
// - no "detected from N files"
// - no JSON/path dumps
// - optional technical evidence only behind details
// ---------------------------------------------------------------------------

function hpText(value, n = 260) {
  let text = String(value || "")
    .replace(/Reading prompt from stdin\.\.\./gi, "")
    .replace(/Agent Message:/gi, "")
    .replace(/\{[^{}]{0,500}\}/g, "")
    .replace(/\b(record_format|record_type|source_family|agent_message|search_result)\b/gi, "")
    .replace(/\b(experiment_execution|literature_search|resource_finder|execution_transcript)\b/gi, "")
    .replace(/\s+/g, " ")
    .trim();

  if (!text) return "";
  return text.length <= n ? text : text.slice(0, n - 1) + "…";
}

function hpEvidence(data) {
  return data?.trajectoryEvidence?.lifecycleEvidence || {};
}

function hpStageStatus(info) {
  const count = info?.artifactCount || 0;
  if (count >= 2) return "covered";
  if (count === 1) return "partial";
  return "unclear";
}

function hpStageLabel(status) {
  return {
    covered: "Covered",
    partial: "Partly covered",
    unclear: "Unclear",
  }[status] || "Unclear";
}

function hpStageSummary(stage, info) {
  const evidence = info?.evidence || [];
  const paths = evidence.map((x) => String(x.path || "").toLowerCase());
  const snippets = evidence.map((x) => hpText(x.snippet || "", 180)).filter(Boolean);

  if (stage === "idea") {
    const snippet = snippets.find((x) => /logit lens|implicit token|research title|research task/i.test(x));
    return snippet
      ? `NeuriCo began with a research question about ${hpText(snippet, 190)}`
      : "NeuriCo started from a defined research question and task prompt.";
  }

  if (stage === "review") {
    return "NeuriCo reviewed related work and background papers to place the task in context.";
  }

  if (stage === "design") {
    if (paths.some((p) => p.includes("config") || p.includes("planning") || p.includes("run_"))) {
      return "NeuriCo planned the method, evaluation setup, and experiment implementation before running the study.";
    }
    return "NeuriCo appears to have prepared a method or evaluation setup, but the design details are only partly visible.";
  }

  if (stage === "experiment") {
    return "NeuriCo ran or prepared the main experiment using project code and saved execution steps.";
  }

  if (stage === "analysis") {
    if (paths.some((p) => p.includes("figures") || p.includes("metrics") || p.includes("results"))) {
      return "NeuriCo produced measurable results such as metrics, figures, or result summaries.";
    }
    return "NeuriCo appears to have produced some analysis outputs, but the main findings need review.";
  }

  if (stage === "interpretation") {
    return "NeuriCo wrote explanatory material connecting the results to the research question.";
  }

  if (stage === "report") {
    return "NeuriCo produced a written report or paper-style draft summarizing the work.";
  }

  return "This stage needs review.";
}

function hpStageOutcome(stage, info) {
  const paths = (info?.evidence || []).map((x) => String(x.path || "").toLowerCase());

  if (stage === "idea") return "A research question was established.";
  if (stage === "review") return "Relevant prior work was gathered.";
  if (stage === "design") return "An evaluation plan and implementation path were prepared.";
  if (stage === "experiment") return "The experiment was run or prepared for execution.";
  if (stage === "analysis") return "Results and figures were produced.";
  if (stage === "interpretation") return "Findings were explained in writing.";
  if (stage === "report") return "A final report or paper draft was created.";

  return "Outcome needs review.";
}

function hpStageConcern(stage, status) {
  if (status === "covered") return "Ready for annotation review.";
  if (status === "partial") return "Some evidence exists, but a human should check whether this stage is complete.";

  return {
    idea: "No clear starting question was found in the current summarized evidence.",
    review: "No clear literature review was found in the current summarized evidence.",
    design: "No clear experiment design was found in the current summarized evidence.",
    experiment: "No clear experiment run was found in the current summarized evidence.",
    analysis: "No clear result analysis was found in the current summarized evidence.",
    interpretation: "No clear interpretation was found in the current summarized evidence.",
    report: "No clear final report was found in the current summarized evidence.",
  }[stage] || "This stage is unclear.";
}

function hpStageData(data) {
  const evidence = hpEvidence(data);
  const order = [
    ["idea", "Research idea", "What question was NeuriCo trying to answer?"],
    ["review", "Literature review", "What background or prior work did it use?"],
    ["design", "Experiment design", "How did it plan to test the idea?"],
    ["experiment", "Experiment run", "What did it execute or implement?"],
    ["analysis", "Result analysis", "What results did it produce?"],
    ["interpretation", "Interpretation", "What did it conclude from the results?"],
    ["report", "Report", "What final write-up was produced?"],
  ];

  return order.map(([id, title, question]) => {
    const info = evidence[id] || {};
    const status = hpStageStatus(info);
    return {
      id,
      title,
      question,
      status,
      statusLabel: hpStageLabel(status),
      summary: hpStageSummary(id, info),
      outcome: hpStageOutcome(id, info),
      concern: hpStageConcern(id, status),
      technicalEvidence: info.evidence || [],
    };
  });
}

function hpChronologicalStory(data) {
  const events = typeof trNormalizeEvents === "function" ? trNormalizeEvents(data) : (data.events || []);

  const groups = [];
  let current = null;

  for (const event of events) {
    const phase = event._phase || event.phase || "unknown";
    const agent = event._agent || event.agent || "unknown";
    const readable = typeof cleanPhaseName === "function" ? cleanPhaseName(phase) : String(phase).replaceAll("_", " ");
    const worker = typeof cleanAgentName === "function" ? cleanAgentName(agent) : String(agent).replaceAll("_", " ");
    const key = `${readable}::${worker}`;

    if (!current || current.key !== key) {
      if (current) groups.push(current);
      current = {
        key,
        title: readable,
        worker,
        start: event._index ?? groups.length,
        end: event._index ?? groups.length,
        events: [],
      };
    }

    current.end = event._index ?? current.end;
    current.events.push(event);
  }

  if (current) groups.push(current);

  return groups.map((group, index) => {
    const picked = [
      group.events[0],
      group.events[Math.floor(group.events.length / 2)],
      group.events[group.events.length - 1],
    ].filter(Boolean);

    const snippets = [...new Set(picked.map((e) => hpText(e._text || e.text || "", 90)).filter(Boolean))];

    return {
      id: `step-${index + 1}`,
      title: group.title,
      worker: group.worker,
      range: `steps #${group.start}–#${group.end}`,
      count: group.events.length,
      summary: snippets.length
        ? `This part focused on ${group.title.toLowerCase()}. ${snippets.join(" ")}`
        : `This part focused on ${group.title.toLowerCase()}.`,
    };
  });
}

