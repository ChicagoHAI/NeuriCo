// Shows a live banner while the server auto-generates this project's world model,
// and reloads the page once it's ready.
function renderWorldModelBanner(info, kind) {
  let banner = document.querySelector("#wm-banner");
  if (kind === "hidden") {
    banner?.remove();
    return;
  }
  if (!banner) {
    banner = document.createElement("div");
    banner.id = "wm-banner";
    document.body.appendChild(banner);
  }
  banner.className = `wm-banner ${kind}`;
  const last = info.log?.length ? info.log[info.log.length - 1] : "";
  const secs = Math.round((info.elapsedMs || 0) / 1000);
  if (kind === "running") {
    banner.innerHTML = `
      <span class="wm-spin"></span>
      <div>
        <strong>Generating world model… ${secs ? `(${secs}s)` : ""}</strong>
        <span class="wm-sub">Reading the run's artifacts. Decisions &amp; Whiteboard will fill in. ${escapeHtml(last)}</span>
      </div>`;
  } else if (kind === "done") {
    banner.innerHTML = `<span class="wm-check">✓</span><div><strong>World model ready</strong><span class="wm-sub">Reloading…</span></div>`;
  } else {
    banner.innerHTML = `
      <span class="wm-x">⚠</span>
      <div><strong>World model not generated</strong><span class="wm-sub">${escapeHtml(info.message || "")}</span></div>
      <button class="wm-close" aria-label="Dismiss">✕</button>`;
    banner.querySelector(".wm-close").onclick = () => banner.remove();
  }
}

async function watchWorldModel() {
  let info;
  try {
    info = await (await fetch("/api/world-model-status")).json();
  } catch {
    return;
  }
  if (info.state === "running" || info.state === "checking") {
    sessionStorage.removeItem("wm-reloaded");      // a fresh build is in progress
    renderWorldModelBanner(info, "running");
    setTimeout(watchWorldModel, 3000);
  } else if (info.state === "done") {
    if (sessionStorage.getItem("wm-reloaded")) {   // already reloaded for this build
      renderWorldModelBanner(info, "hidden");
      return;
    }
    sessionStorage.setItem("wm-reloaded", "1");
    renderWorldModelBanner(info, "done");
    setTimeout(() => location.reload(), 1200);
  } else if (["failed", "error", "unavailable"].includes(info.state)) {
    renderWorldModelBanner(info, "error");
  } else {
    renderWorldModelBanner(info, "hidden"); // present / disabled
  }
}

