function tmText(value, n = 260) {
  let text = String(value || "")
    .replace(/Reading prompt from stdin\.\.\./gi, "")
    .replace(/Agent Message:/gi, "")
    .replace(/\{[^{}]{0,500}\}/g, "")
    .replace(/\b(record_format|record_type|source_family|agent_message|search_result)\b/gi, "")
    .replace(/\b(experiment_execution|literature_search|resource_finder|execution_transcript)\b/gi, "")
    .replace(/\s+/g, " ")
    .trim();

  return text.length <= n ? text : text.slice(0, n - 1) + "…";
}

function tmLifecycleEvidence(data) {
  return data?.trajectoryEvidence?.lifecycleEvidence || {};
}

function tmStatus(info) {
  const count = info?.artifactCount || 0;
  if (count >= 2) return "completed";
  if (count === 1) return "partial";
  return "unclear";
}

function tmStatusLabel(status) {
  return {
    completed: "Completed",
    partial: "Partially completed",
    unclear: "Unclear",
  }[status] || "Unclear";
}

function tmStageSummary(stage, info) {
  const evidence = info?.evidence || [];
  const paths = evidence.map((x) => String(x.path || "").toLowerCase());
  const snippets = evidence.map((x) => tmText(x.snippet || "", 160)).filter(Boolean);

  if (stage === "idea") {
    const s = snippets.find((x) => /logit lens|implicit token|research/i.test(x));
