// ---------------------------------------------------------------------------
// Artifact-grounded scientific lifecycle renderer.
// This uses trajectoryEvidence from canonical_trajectory.json, not only event phases.
// ---------------------------------------------------------------------------

function artCleanText(value, n = 360) {
  if (typeof cleanHumanText === "function") return cleanHumanText(value, n);
  let text = String(value || "").replace(/\s+/g, " ").trim();
  return text.length <= n ? text : text.slice(0, n - 1) + "…";
}

function artStageTitle(stage) {
  return {
    idea: "Research idea",
    review: "Literature review",
    design: "Experiment design",
    experiment: "Experiment run",
    analysis: "Result analysis",
    interpretation: "Interpretation",
    report: "Report",
  }[stage] || stage;
}

function artStageSubtitle(stage) {
  return {
    idea: "task, prompt, research question, or starting hypothesis",
    review: "papers, related work, references, and background evidence",
    design: "plan, method, model, metric, dataset, config, or code setup",
    experiment: "scripts, commands, tools, and implementation used to run the study",
    analysis: "metrics, plots, result tables, summaries, and evaluation outputs",
    interpretation: "explanation, limitations, implications, and discussion",
    report: "final report, paper draft, PDF, TeX, or written summary",
  }[stage] || "";
}

function artLifecycleCards(data) {
  const evidence = data?.trajectoryEvidence?.lifecycleEvidence || {};
  const order = ["idea", "review", "design", "experiment", "analysis", "interpretation", "report"];

  return order.map((stage) => {
    const info = evidence[stage] || {};
    return {
      id: stage,
      title: artStageTitle(stage),
      subtitle: artStageSubtitle(stage),
      artifactCount: info.artifactCount || 0,
      evidence: info.evidence || [],
      detected: (info.artifactCount || 0) > 0,
    };
  });
}

function artEvidenceLine(item) {
  const snippet = artCleanText(item.snippet || "", 220);
  if (snippet) return `${item.path}: ${snippet}`;
  return item.path || item.kind || "file evidence";
}

function artBuildChronologicalParts(data, candidates) {
  if (typeof cleanBuildRunParts === "function") {
    return cleanBuildRunParts(data, candidates || []);
  }

  const events = typeof trNormalizeEvents === "function" ? trNormalizeEvents(data) : (data.events || []);
  const parts = [];
  let current = null;

  for (const event of events) {
    const phase = event._phase || event.phase || "unknown";
    const agent = event._agent || event.agent || "unknown";
    const key = `${phase}::${agent}`;

    if (!current || current.key !== key) {
      if (current) parts.push(current);
      current = {
        id: `P${String(parts.length + 1).padStart(3, "0")}`,
        key,
        phase,
        agent,
        startIndex: event._index ?? parts.length,
        endIndex: event._index ?? parts.length,
        events: [],
        candidates: [],
      };
    }

    current.endIndex = event._index ?? current.endIndex;
    current.events.push(event);
  }

  if (current) parts.push(current);
  return parts;
}

function artPhaseName(value) {
  if (typeof cleanPhaseName === "function") return cleanPhaseName(value);
  return String(value || "Other work").replaceAll("_", " ");
}

function artAgentName(value) {
  if (typeof cleanAgentName === "function") return cleanAgentName(value);
  return String(value || "NeuriCo").replaceAll("_", " ");
}

function artStyles() {
  return `
