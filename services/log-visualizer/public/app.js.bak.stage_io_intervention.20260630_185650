// ---------------------------------------------------------------------------
// Trajectory + benchmark-candidate helpers.
// Trajectory is for understanding how NeuriCo moved idea → result.
// Decisions remains the annotation surface.
// ---------------------------------------------------------------------------

let trCanonical = null;
let trCanonicalRunId = null;
let trStory = null;
let trCandidates = null;

const TR_STAGE_LABELS = {
  idea: "Initial idea",
  planning: "Planning",
  literature_search: "Literature search",
  hypothesis: "Hypothesis / claim",
  experiment_design: "Experiment design",
  implementation: "Implementation",
  execution: "Execution",
  analysis: "Analysis",
  interpretation: "Interpretation",
  report_writing: "Report writing",
  feedback_incorporation: "Feedback incorporation",
  other: "Other",
};

function trShort(value, n = 220) {
  const text = String(value || "").replace(/\s+/g, " ").trim();
  return text.length <= n ? text : `${text.slice(0, n - 1)}…`;
}

function trEventId(event, index) {
  return String(event.eventId || event.id || event.event_id || `E${String(index).padStart(5, "0")}`);
}

function trEventIndex(event, index) {
  return Number(event.eventIndex ?? event.index ?? index);
}

function trEventText(event) {
  return [
    event.summary,
    event.rawPreview,
    event.raw_text,
    event.eventType,
    event.phase,
    event.agent,
  ].filter(Boolean).join(" ").replace(/\s+/g, " ").trim();
}

function trNormalizeEvents(data) {
  const raw = data.events || data.canonicalEvents || [];
  return raw.map((event, index) => {
    const e = { ...event };
    e._id = trEventId(e, index);
    e._index = trEventIndex(e, index);
    e._text = trEventText(e);
    e._phase = e.phase || "unknown";
    e._agent = e.agent || "unknown";
    e._type = e.eventType || e.type || "event";
    return e;
  }).sort((a, b) => a._index - b._index);
}

function trNormalizeArtifacts(data) {
  const raw = data.artifacts || [];
  return raw.map((artifact, index) => {
    const a = { ...artifact };
    a._id = String(a.artifactId || a.id || a.artifact_id || `A${String(index).padStart(5, "0")}`);
    a._name = String(a.path || a.filePath || a.relativePath || a.name || a._id);
    a._summary = trShort(a.summary || a.content || a.preview || a.text || "", 300);
    return a;
  });
}

function trArtifactIds(event) {
  const ids = [];
  for (const key of ["artifactIds", "linkedArtifactIds", "artifacts", "artifact_ids"]) {
    if (Array.isArray(event[key])) ids.push(...event[key].map(String));
  }
  return [...new Set(ids)];
}

function trClassifyStage(event) {
  const text = String(event._text || "").toLowerCase();
  const phase = String(event.phase || "").toLowerCase();
  const agent = String(event.agent || "").toLowerCase();
  const type = String(event.eventType || "").toLowerCase();

  if (/\b(user|prompt|task|goal|initial idea|research idea)\b/.test(text) && event._index < 20) return "idea";
  if (/\b(plan|todo|roadmap|next step|strategy|approach)\b/.test(text)) return "planning";
  if (phase.includes("literature") || agent.includes("resource_finder") || /\b(paper|abstract|citation|related work|openalex|arxiv|pubmed|semantic scholar|search result)\b/.test(text)) return "literature_search";
  if (/\b(hypothesis|claim|research question|assumption)\b/.test(text)) return "hypothesis";
  if (/\b(baseline|dataset|metric|evaluation|protocol|ablation|model choice|threshold|split|experimental design|design choice)\b/.test(text)) return "experiment_design";
  if (/\b(write_file|edit|patch|function|class|script|\.py|implementation|implement|code)\b/.test(text) || type.includes("code")) return "implementation";
  if (/\b(run|execute|command|stdout|stderr|traceback|python|bash|terminal|failed|error)\b/.test(text)) return "execution";
  if (/\b(result|accuracy|metric|score|p-value|confidence interval|bootstrap|table|plot|csv|finding)\b/.test(text)) return "analysis";
  if (/\b(interpret|interpretation|conclusion|implication|suggests|supports|limitation|generaliz)\b/.test(text)) return "interpretation";
  if (/\b(report|paper|abstract|introduction|method section|results section|conclusion section|writeup|draft)\b/.test(text)) return "report_writing";
  if (/\b(feedback|correction|revise|incorporate|acknowledge|user said)\b/.test(text)) return "feedback_incorporation";
  if (phase.includes("experiment_execution")) return "execution";

  return "other";
}

function trImportanceScore(event) {
  const text = String(event._text || "").toLowerCase();
  let score = 0;

  if (/\b(error|failed|failure|exception|traceback|timeout|invalid|not found)\b/.test(text)) score += 6;
  if (/\b(decide|choose|selected|baseline|model|metric|dataset|threshold|protocol|design)\b/.test(text)) score += 5;
  if (/\b(uncertain|unclear|maybe|possibly|likely|assumption|risk|limitation)\b/.test(text)) score += 4;
  if (/\b(result|finding|accuracy|metric|p-value|confidence|bootstrap|significant)\b/.test(text)) score += 4;
  if (/\b(feedback|correction|revise|incorporate|acknowledge)\b/.test(text)) score += 4;
  if (/\b(report|paper|conclusion|interpretation|claim)\b/.test(text)) score += 2;

  return score;
}

function trCandidateType(event) {
  const text = String(event._text || "").toLowerCase();

  if (/\b(feedback|correction|revise|incorporate|acknowledge)\b/.test(text)) return "feedback_incorporation_check";
  if (/\b(error|failed|failure|exception|traceback|timeout|invalid|not found)\b/.test(text)) return "interruption_opportunity";
  if (/\b(uncertain|unclear|maybe|possibly|likely|assumption|risk|limitation)\b/.test(text)) return "uncertainty_not_surfaced";
  if (/\b(missing|need|insufficient|not enough|unknown|cannot determine)\b/.test(text)) return "missing_information";
  if (/\b(decide|choose|selected|baseline|model|metric|dataset|threshold|protocol|design)\b/.test(text)) return "critical_decision";
  if (/\b(result|finding|accuracy|metric|p-value|confidence|bootstrap|significant)\b/.test(text)) return "user_update_opportunity";
  if (/\b(crux|key question|depends on|most important)\b/.test(text)) return "crux_for_user_decision";

  return "user_update_opportunity";
}

function trCandidateWhy(type) {
  return {
    critical_decision: "A design, method, baseline, metric, or interpretation choice may affect the final research result.",
    user_update_opportunity: "The agent may have reached information that would help a user decide whether to steer or approve continuation.",
    interruption_opportunity: "The next action may need human review because the trajectory shows failure, risk, or a consequential choice.",
    missing_information: "The agent may be acting without information that should be surfaced to the user.",
    uncertainty_not_surfaced: "The agent may need to communicate uncertainty, assumptions, or limitations.",
    crux_for_user_decision: "This may be a key crux that determines whether the user would steer the run.",
    feedback_incorporation_check: "This checks whether later behavior actually incorporated previous feedback.",
  }[type] || "This may be useful for annotation.";
}

function trStageWarnings(events) {
  const text = events.map((event) => event._text || "").join(" ").toLowerCase();
  const warnings = [];

  if (/\b(error|failed|exception|traceback|timeout)\b/.test(text)) warnings.push("Potential execution or tool failure appears in this stage.");
  if (/\b(uncertain|unclear|assumption|risk|limitation)\b/.test(text)) warnings.push("Uncertainty or limitation may need to be surfaced.");
  if (/\b(decide|choose|baseline|metric|dataset|threshold)\b/.test(text)) warnings.push("This stage contains possible decision points.");

  return warnings;
}

function trBuildStory(data) {
  const events = trNormalizeEvents(data);
  const artifacts = trNormalizeArtifacts(data);
  const stages = [];
  let current = null;

  for (const event of events) {
    const stageType = trClassifyStage(event);

    if (!current || current.stageType !== stageType) {
      if (current) stages.push(current);
      current = {
        stageId: `S${String(stages.length + 1).padStart(3, "0")}`,
        stageType,
        title: TR_STAGE_LABELS[stageType] || stageType,
        eventIds: [],
        artifactIds: [],
        _events: [],
      };
    }

    current.eventIds.push(event._id);
    current.artifactIds.push(...trArtifactIds(event));
    current._events.push(event);
  }

  if (current) stages.push(current);

  for (const stage of stages) {
    stage.artifactIds = [...new Set(stage.artifactIds)];
    const keyEvents = [...stage._events]
      .sort((a, b) => trImportanceScore(b) - trImportanceScore(a) || a._index - b._index)
      .slice(0, 3);

    stage.keyEventIds = keyEvents.map((event) => event._id);

    const examples = keyEvents
      .map((event) => trShort(event._text, 130))
      .filter(Boolean)
      .slice(0, 2)
      .join("; ");

    stage.summary = examples
      ? `${stage.title}: NeuriCo spent ${stage.eventIds.length} event(s) in this stage. Important signals include: ${examples}`
      : `${stage.title}: NeuriCo spent ${stage.eventIds.length} event(s) in this stage.`;

    stage.warnings = trStageWarnings(stage._events);
    delete stage._events;
  }

  const taskGoalEvent = events
    .slice(0, 30)
    .find((event) => /\b(task|goal|research|investigate|study|idea|question)\b/i.test(event._text));

  const finalEvent = [...events]
    .reverse()
    .slice(0, 80)
    .find((event) => /\b(conclusion|final|report|finding|result|paper|summary)\b/i.test(event._text));

  return {
    runId: currentRunId,
    generatedAt: new Date().toISOString(),
    taskGoal: trShort(taskGoalEvent?._text || events[0]?._text || `Trajectory for ${currentRunId}`, 420),
    finalOutcome: trShort(finalEvent?._text || "No final outcome inferred yet.", 420),
    stageCount: stages.length,
    eventCount: events.length,
    artifactCount: artifacts.length,
    stages,
  };
}

function trContextIds(events, index) {
  return [index - 1, index, index + 1]
    .filter((i) => i >= 0 && i < events.length)
    .map((i) => events[i]._id);
}

function trBuildCandidates(data, story) {
  const events = trNormalizeEvents(data);

  const eventToStage = {};
  for (const stage of story.stages || []) {
    for (const eventId of stage.eventIds || []) eventToStage[eventId] = stage.stageId;
  }

  const candidates = [];

  const preferredStages = [
    "idea",
    "hypothesis",
    "experiment_design",
    "implementation",
    "analysis",
    "interpretation",
    "report_writing",
  ];

  let decisionCount = 0;
  for (const stageType of preferredStages) {
    const stage = (story.stages || []).find((item) => item.stageType === stageType);
    if (!stage) continue;

    decisionCount += 1;
    candidates.push({
      candidateId: `D${String(decisionCount).padStart(3, "0")}`,
      runId: currentRunId,
      stageId: stage.stageId,
      candidateType: "critical_decision",
      title: `Critical decision in ${stage.title}`,
      summary: stage.summary,
      whyCandidate: "This stage may contain a high-level scientific decision that affects downstream findings or user steering.",
      systemSuggestion: {
        should_update_user: ["experiment_design", "analysis", "interpretation", "report_writing"].includes(stageType),
        interrupt_next_action: stageType === "experiment_design",
      },
      evidenceEventIds: (stage.keyEventIds || stage.eventIds || []).slice(0, 3),
      artifactIds: (stage.artifactIds || []).slice(0, 5),
      labels: null,
    });

    if (decisionCount >= 6) break;
  }

  const scored = events
    .map((event, index) => ({ event, index, score: trImportanceScore(event) }))
    .filter((item) => item.score > 0)
    .sort((a, b) => b.score - a.score || a.index - b.index)
    .slice(0, 80);

  let count = 0;
  for (const item of scored) {
    count += 1;
    const type = trCandidateType(item.event);

    const shouldUpdate = [
      "user_update_opportunity",
      "critical_decision",
      "missing_information",
      "uncertainty_not_surfaced",
      "crux_for_user_decision",
    ].includes(type);

    const shouldInterrupt = [
      "interruption_opportunity",
      "missing_information",
      "critical_decision",
    ].includes(type) && item.score >= 5;

    candidates.push({
      candidateId: `C${String(count).padStart(3, "0")}`,
      runId: currentRunId,
      stageId: eventToStage[item.event._id],
      candidateType: type,
      title: trShort(item.event._text, 130) || `Candidate around event ${item.event._index}`,
      summary: trShort(item.event._text, 360),
      whyCandidate: trCandidateWhy(type),
      systemSuggestion: {
        should_update_user: shouldUpdate,
        interrupt_next_action: shouldInterrupt,
      },
      evidenceEventIds: trContextIds(events, item.index),
      artifactIds: trArtifactIds(item.event),
      labels: null,
    });
  }

  return candidates;
}

async function trLoadWorkbench() {
  if (trCanonical && trCanonicalRunId === currentRunId && trStory && trCandidates) {
    return { data: trCanonical, story: trStory, candidates: trCandidates };
  }

  const response = await fetch(`/api/canonical-run?runId=${encodeURIComponent(currentRunId)}`);
  if (!response.ok) throw new Error(await response.text());

  trCanonical = await response.json();
  trCanonicalRunId = currentRunId;
  trStory = trBuildStory(trCanonical);
  trCandidates = trBuildCandidates(trCanonical, trStory);

  return { data: trCanonical, story: trStory, candidates: trCandidates };
}

