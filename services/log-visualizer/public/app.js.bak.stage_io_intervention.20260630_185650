    return "NeuriCo gathered related work and background evidence to understand the research context.";
  }

  if (stage === "design") {
    return "NeuriCo planned the experiment setup, including method, configuration, metrics, or implementation path.";
  }

  if (stage === "experiment") {
    return "NeuriCo prepared or ran the main experiment through project code and saved execution activity.";
  }

  if (stage === "analysis") {
    return "NeuriCo produced result artifacts such as metrics, figures, summaries, or evaluation outputs.";
  }

  if (stage === "interpretation") {
    return "NeuriCo connected the results back to the research question and explained the findings.";
  }

  if (stage === "report") {
    return "NeuriCo produced a written report or paper-style draft for the completed research work.";
  }

  return "This stage needs review.";
}

function tmStageOutput(stage) {
  return {
    idea: "Research direction established",
    review: "Prior work gathered",
    design: "Experiment plan prepared",
    experiment: "Experiment activity completed or partly completed",
    analysis: "Results summarized",
    interpretation: "Findings explained",
    report: "Report or paper draft produced",
  }[stage] || "Output needs review";
}

function tmStageQuestion(stage) {
  return {
    idea: "Was the research question clear enough for the agent to start?",
    review: "Did the agent gather enough prior work before deciding what to do?",
    design: "Was the experiment design appropriate for the question?",
    experiment: "Did the execution follow the intended design?",
    analysis: "Were the results analyzed carefully enough?",
    interpretation: "Did the agent explain limitations and implications correctly?",
    report: "Did the final write-up reflect the actual evidence?",
  }[stage] || "What should the annotator check?";
}

function tmStages(data) {
  const evidence = tmLifecycleEvidence(data);

  const order = [
    ["idea", "Research idea"],
    ["review", "Literature review"],
    ["design", "Experiment design"],
    ["experiment", "Experiment run"],
    ["analysis", "Result analysis"],
    ["interpretation", "Interpretation"],
    ["report", "Report"],
  ];

  return order.map(([id, title], i) => {
    const info = evidence[id] || {};
    const status = tmStatus(info);

    return {
      id,
      number: i + 1,
      title,
      status,
      statusLabel: tmStatusLabel(status),
      summary: tmStageSummary(id, info),
      output: tmStageOutput(id),
      question: tmStageQuestion(id),
      evidence: info.evidence || [],
    };
  });
}

