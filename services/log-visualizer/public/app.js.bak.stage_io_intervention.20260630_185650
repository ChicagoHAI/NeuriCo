function wireEventsControls(events) {
  const phaseSelect = root.querySelector("#events-phase-filter");
  const agentSelect = root.querySelector("#events-agent-filter");
  const searchInput = root.querySelector("#events-search-input");
  const tableHost = root.querySelector("#events-table-host");

  const readableHost = root.querySelector("#events-readable-host");

  const rerenderTable = () => {
    if (readableHost) {
      readableHost.innerHTML = `
        ${renderTrajectoryGraph(events.filter(eventMatchesFilters))}
        ${renderTrajectorySegments(events.filter(eventMatchesFilters))}
        ${renderReadableEventCards(events)}
      `;
    }
