}


function wireEventAnnotationButtons() {
  root.querySelectorAll(".event-label-btn").forEach((button) => {
    button.addEventListener("click", () => {
      saveEventAnnotation(
        button.dataset.eventId,
        Number(button.dataset.eventIndex),
        button.dataset.action
      );
    });
  });
}


function countByValue(items, getValue) {
  const counts = {};
  for (const item of items || []) {
    const value = getValue(item) || "unknown";
    counts[value] = (counts[value] || 0) + 1;
  }
  return counts;
}

function sortedCountEntries(counts) {
  return Object.entries(counts || {}).sort((a, b) => b[1] - a[1]);
}

function stableColor(value) {
  const text = String(value || "unknown");
  let hash = 0;
  for (let i = 0; i < text.length; i++) {
    hash = ((hash << 5) - hash) + text.charCodeAt(i);
    hash |= 0;
  }
  const hue = Math.abs(hash) % 360;
  return `hsl(${hue} 62% 52%)`;
}

function renderCountBars(title, counts, total) {
  const entries = sortedCountEntries(counts);
  if (!entries.length) {
    return `
      <div class="events-analysis-card">
        <h4>${escapeHtml(title)}</h4>
        <p class="muted">No data available.</p>
      </div>
    `;
  }

  return `
    <div class="events-analysis-card">
      <h4>${escapeHtml(title)}</h4>
      <div class="events-bar-list">
        ${entries.map(([name, count]) => {
          const pct = total ? Math.round((count / total) * 100) : 0;
          return `
            <div class="events-bar-row">
              <div class="events-bar-label">
                <span>${escapeHtml(name)}</span>
                <strong>${escapeHtml(count)} · ${pct}%</strong>
              </div>
              <div class="events-bar-track">
                <div class="events-bar-fill" style="width:${Math.max(3, pct)}%; background:${stableColor(name)}"></div>
              </div>
            </div>
          `;
        }).join("")}
      </div>
    </div>
  `;
}

function compressByConsecutiveValue(events, getValue) {
  const segments = [];
  for (const event of events || []) {
    const value = getValue(event) || "unknown";
    const last = segments[segments.length - 1];
    if (last && last.value === value) {
      last.count += 1;
      last.end = event.eventIndex;
    } else {
      segments.push({
        value,
        count: 1,
        start: event.eventIndex,
        end: event.eventIndex,
      });
    }
  }
  return segments;
}

function renderTrajectoryStrip(events) {
  const segments = compressByConsecutiveValue(events, (event) => event.phase);
  const total = events.length || 1;

  return `
    <div class="events-analysis-card events-wide-card">
      <div class="events-card-heading">
        <h4>Phase timeline</h4>
        <span class="muted">${segments.length} phase segment${segments.length === 1 ? "" : "s"} across ${events.length} events</span>
      </div>

      <div class="events-timeline-strip" title="Compressed phase sequence">
        ${segments.map((segment) => {
          const width = Math.max(0.8, (segment.count / total) * 100);
          return `
            <div class="events-timeline-segment"
              title="${escapeHtml(segment.value)} · events ${escapeHtml(segment.start)}–${escapeHtml(segment.end)} · ${escapeHtml(segment.count)} events"
              style="width:${width}%; background:${stableColor(segment.value)}">
            </div>
          `;
        }).join("")}
      </div>

      <div class="events-timeline-legend">
        ${sortedCountEntries(countByValue(events, (event) => event.phase)).map(([phase]) => `
          <span class="events-legend-item">
            <span class="events-legend-swatch" style="background:${stableColor(phase)}"></span>
            ${escapeHtml(phase)}
          </span>
        `).join("")}
      </div>
    </div>
  `;
}

function renderPhaseTransitions(events) {
  const transitions = {};
  for (let i = 1; i < (events || []).length; i++) {
    const prev = events[i - 1].phase || "unknown";
    const curr = events[i].phase || "unknown";
    const key = `${prev} → ${curr}`;
    transitions[key] = (transitions[key] || 0) + 1;
  }

  const entries = sortedCountEntries(transitions).slice(0, 8);

  return `
    <div class="events-analysis-card">
      <h4>Phase transitions</h4>
      ${entries.length ? `
        <div class="events-transition-list">
          ${entries.map(([name, count]) => `
            <div class="events-transition-row">
              <span>${escapeHtml(name)}</span>
              <strong>${escapeHtml(count)}</strong>
            </div>
          `).join("")}
        </div>
      ` : `<p class="muted">No transitions available.</p>`}
    </div>
  `;
}

