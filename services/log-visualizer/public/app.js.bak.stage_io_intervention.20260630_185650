                  <button class="event-label-btn" data-action="interrupt" data-event-id="${escapeHtml(event.eventId)}" data-event-index="${escapeHtml(event.eventIndex)}">interrupt</button>
                  <button class="event-label-btn" data-action="none" data-event-id="${escapeHtml(event.eventId)}" data-event-index="${escapeHtml(event.eventIndex)}">no label</button>
